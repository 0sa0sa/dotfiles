def finding_rows(f, w):
    sev = norm_sev(f.get("severity")) if isinstance(f, dict) else "other"
    if not isinstance(f, dict):
        return [[("  " + str(f), "")]]
    loc = f.get("file") or ""
    if loc and f.get("line") is not None:
        loc += f":{f['line']}"
    text = " ".join(str(f.get("problem") or "").split())
    fix = " ".join(str(f.get("fix") or "").split())
    rows = []
    first = True
    for ln in wrap(f"{loc} {text}".strip(), max(10, w - 12)):
        rows.append([("  " + (f"[{sev}]".ljust(8) if first else " " * 8) + " ", SEV_STYLE[sev]), (ln, "")])
        first = False
    if fix:
        for i, ln in enumerate(wrap("fix: " + fix, max(10, w - 12))):
            rows.append([(" " * 11, ""), (ln, "2")])
    return rows


def result_rows_full(result, w):
    if result is None:
        return [[("  (結果なし)", "2")]]
    if is_error_result(result):
        msg = result.get("error") if isinstance(result, dict) else result
        return [[("  " + ln, "31")] for ln in wrap(str(msg), w - 2)]
    if isinstance(result, dict):
        rows = []
        fl = result.get("findings")
        if isinstance(fl, list):
            c = sev_counts(fl)
            rows.append([(f"  findings {len(fl)}: high {c['high']} · medium {c['medium']} · low {c['low']}", "1")])
            for f in sorted(fl, key=lambda f: SEV_ORDER[norm_sev(f.get("severity") if isinstance(f, dict) else None)]):
                rows += finding_rows(f, w)
            rest = {k: v for k, v in result.items() if k != "findings"}
            if not rest:
                return rows
            result = rest
        body = json.dumps(result, ensure_ascii=False, indent=2)
        return rows + [[("  " + ln, "")] for t in body.splitlines() for ln in wrap(t, w - 2)]
    if isinstance(result, str):
        return [[("  " + ln, "")] for t in result.splitlines() for ln in (wrap(t, w - 2) if t else [""])]
    return [[("  " + json.dumps(result, ensure_ascii=False), "")]]


def detail_rows(m, vs, w):
    r = next((x for x in m.rows if x["id"] == vs.detail_id), None)
    if not r:
        return [[("agent が見つからない", "31")]]
    icon, st = STATE_STYLE[r["state"]]
    rows = [[("◆ ", "1;36"), (r["label"], "1;36"), ("  " + r["phase"], "36")],
            [(icon + " " + r["state"], st), (f"  経過 {fmt_elapsed(r['elapsed'])}  tok {fmt_tokens(r['tokens'])}"
                                              f"  tools {r['tools']}  {r['model']}", ""), ("  " + r["id"], "2")]]
    if r["desc"]:
        rows.append([(r["desc"], "2")])
    rows.append(rule("今", w))
    if r["state"] in ("running", "stalled"):
        rows.append(agent_tool_row(r, "  ") + ([(" ! tool error", "31")] if r["tool_error"] else []))
        rows.append(agent_text_row(r, w, "  "))
    else:
        rows.append([("  終了済み", "2")])
    rows.append(rule("直近の動き", w))
    if r["recent"]:
        for ts, kind, summ in r["recent"]:
            kst = {"tool": "36", "error": "31", "result": "2", "text": ""}.get(kind, "")
            rows.append([(" " + (time.strftime("%H:%M:%S", time.localtime(ts)) if ts else "--:--:--") + " ", "2"),
                         (pad(kind, 6), kst), (" " + summ, kst if kind == "error" else "")])
    else:
        rows.append([("  (履歴なし: 完了 agent は最終読込後に破棄)", "2")])
    rows.append(rule("結果", w))
    if r["state"] in ("running", "stalled"):
        rows.append([("  (実行中)", "2")])
    else:
        rows += result_rows_full(r["result"], w)
    return rows


def results_view_rows(m, w):
    fin = sorted([r for r in m.rows if r["state"] in ("done", "error")], key=lambda r: r["last_ts"] or 0,
                 reverse=True)
    allf = [f for r in fin if isinstance(r["result"], dict) and isinstance(r["result"].get("findings"), list)
            for f in r["result"]["findings"]]
    c = sev_counts(allf)
    rows = [[(f" findings 計 {len(allf)}: ", "1"), (f"high {c['high']}", "31"), (" · ", "2"),
             (f"medium {c['medium']}", "33"), (" · ", "2"), (f"low {c['low']}", "2")], rule("結果一覧", w)]
    for r in fin:
        icon, st = STATE_STYLE[r["state"]]
        rows.append([(" " + icon + " ", st), (r["label"], "1"), ("  " + r["phase"], "36"),
                     (f"  {fmt_elapsed(r['elapsed'])}", "2")])
        res = r["result"]
        if isinstance(res, dict) and isinstance(res.get("findings"), list) and res["findings"]:
            for f in sorted(res["findings"], key=lambda f: SEV_ORDER[norm_sev(f.get("severity") if isinstance(f, dict) else None)]):
                rows += finding_rows(f, w)
        else:
            gist, kind = result_gist(res, max(0, w - 6))
            rows.append([("    " + gist, "31" if kind == "error" else "")])
    return rows


