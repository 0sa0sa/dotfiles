def read_agent_meta(run_dir, aid):
    try:
        with open(os.path.join(run_dir, f"agent-{aid}.meta.json"), encoding="utf-8") as f:
            meta = json.load(f)
        return meta if isinstance(meta, dict) else {}
    except (OSError, ValueError):
        return {}


class RunReader:
    """journal と各 transcript を増分 (バイト offset) で読み、巨大 transcript の再パースを避ける。

    完了 agent は最終 1 回読んだ後に読込を止め、recent / last_text を破棄する。
    agent meta (.meta.json) は初出時に 1 回だけ読む。workflow script は mtime 変化時のみ再読込。
    """

    def __init__(self, run_dir):
        self.run_dir = run_dir
        self.run_id = os.path.basename(os.path.normpath(run_dir))
        self.agents, self.events, self.stats, self.metas = {}, [], {}, {}
        self._offsets = {}
        self._finalized = set()
        self._script = None
        self._script_mtime = None
        self._script_checked = 0.0
        self.wfmeta = None

    def new_lines(self, path):
        try:
            size = os.path.getsize(path)
        except OSError:
            return []
        off = self._offsets.get(path, 0)
        if size <= off:
            return []
        with open(path, "rb") as f:
            f.seek(off)
            data = f.read()
        end = data.rfind(b"\n") + 1  # 書きかけの末尾行は次回に回す
        self._offsets[path] = off + end
        # splitlines() は U+2028/2029/0085 等でも割るので使わない (Node の JSON は U+2028 を生で出す)
        return [ln.decode("utf-8", "replace").rstrip("\r") for ln in data[:end].split(b"\n") if ln.strip()]

    def journal(self):
        for line in self.new_lines(os.path.join(self.run_dir, "journal.jsonl")):
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if isinstance(ev, dict):
                apply_journal_event(self.agents, ev, self.events)
        return self.agents

    def snapshot(self):
        agents = self.journal()
        for aid, a in agents.items():
            if aid in self._finalized:
                continue
            if aid not in self.metas:
                self.metas[aid] = read_agent_meta(self.run_dir, aid)
            st = self.stats.setdefault(aid, new_stats())
            update_stats(st, self.new_lines(os.path.join(self.run_dir, f"agent-{aid}.jsonl")))
            if a["status"] != "running":  # 最終読込済み: 以後は stat しない
                st["recent"].clear()
                st["last_text"], st["last_hint"] = "", ""
                self._finalized.add(aid)
        return agents, self.stats

    def workflow_meta(self, force=False):
        now = time.time()
        if self._script is None and (force or now - self._script_checked > 30):
            self._script_checked = now
            self._script = find_script(self.run_dir)
        if self._script:
            try:
                mt = os.path.getmtime(self._script)
            except OSError:
                return self.wfmeta
            if force or mt != self._script_mtime:
                self._script_mtime = mt
                try:
                    with open(self._script, encoding="utf-8") as f:
                        self.wfmeta = parse_meta_js(f.read())
                except OSError:
                    pass
        return self.wfmeta

    def journal_mtime(self):
        try:
            return os.path.getmtime(os.path.join(self.run_dir, "journal.jsonl"))
        except OSError:
            return None

    def model(self, now, stall_events=()):
        agents, stats = self.snapshot()
        return self.build(now, stall_events)

    def build(self, now, stall_events=()):
        return build_model(self.agents, self.stats, self.metas, self.workflow_meta(), self.run_id, self.events, now,
                           self.journal_mtime(), stall_events)


# ---------- IO: herdr ----------

def hcli(*args):
    """herdr CLI を呼ぶ。失敗 (未インストール / timeout / 不正 JSON 含む) は RuntimeError に統一。"""
    cmd = " ".join(args)
    try:
        proc = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=HCLI_TIMEOUT_SEC)
        if proc.returncode != 0:
            raise RuntimeError(f"herdr {cmd}: {proc.stderr.strip()}")
        out = proc.stdout.strip()
        return json.loads(out).get("result", {}) if out else {}
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"herdr {cmd}: {HCLI_TIMEOUT_SEC}s で応答なし") from None
    except (OSError, ValueError) as e:
        raise RuntimeError(f"herdr {cmd}: {e}") from e


def in_herdr():
    return os.environ.get("HERDR_ENV") == "1" or bool(os.environ.get("HERDR_PANE_ID"))


def self_command(*args):
    return " ".join(shlex.quote(a) for a in [sys.executable, os.path.realpath(__file__), *args])


def report_status(text, title=None):
    """自ペインの custom status を更新 (best-effort)。title があれば pane title も設定、None なら解除。"""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        return
    try:
        hcli("pane", "report-metadata", pane, "--source", SOURCE, "--custom-status", text, "--ttl-ms", "30000",
             *(["--title", title] if title else ["--clear-title"]))
    except (RuntimeError, OSError, ValueError):
        pass


def split_pane(target, direction):
    ref = ["--pane", target] if target else ["--current"]
    res = hcli("pane", "split", *ref, "--direction", direction, "--no-focus")
    pane_id = find_key(res, "pane_id")
    if not pane_id:
        raise RuntimeError(f"pane split の応答に pane_id が無い: {res}")
    return pane_id


def run_in_pane(pane_id, argv):
    hcli("pane", "run", pane_id, self_command(*argv))


def close_panes(pane_ids):
    """途中失敗で残った空ペインを閉じる (best-effort)。"""
    for pane_id in pane_ids:
        try:
            hcli("pane", "close", pane_id)
        except RuntimeError:
            pass


def claim_run(run_id):
    """同じ run を hook と daemon が二重に開かないよう排他マーカーを作る。取れたら True。"""
    d = os.path.join(state_dir(), "opened")
    os.makedirs(d, exist_ok=True)
    try:
        os.close(os.open(os.path.join(d, run_id), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
        return True
    except FileExistsError:
        return False


def release_run(run_id):
    """open に失敗した run の排他マーカーを戻し、再試行可能にする。"""
    try:
        os.unlink(os.path.join(state_dir(), "opened", run_id))
    except OSError:
        pass



# ---------- pure: キー入力 / 差分描画 / 通知 ----------

KEY_ESCAPES = {"\x1b[A": "up", "\x1b[B": "down", "\x1b[C": "right", "\x1b[D": "left", "\x1bOA": "up", "\x1bOB": "down"}
FEED_CYCLE = (0, 5, 10, 20)


def parse_keys(data):
    """端末入力のバイト列 (decode 済み) -> キー名のリスト。"""
    keys, i = [], 0
    while i < len(data):
        ch = data[i]
        if ch == "\x1b":
            seq = data[i:i + 3]
            if seq in KEY_ESCAPES:
                keys.append(KEY_ESCAPES[seq])
                i += 3
            elif data[i + 1:i + 2] in ("[", "O"):  # 未対応の CSI: 終端文字まで読み捨て
                j = i + 2
                while j < len(data) and not data[j].isalpha() and data[j] != "~":
                    j += 1
                i = j + 1
            else:
                keys.append("esc")
                i += 1
        else:
            keys.append({"\r": "enter", "\n": "enter", "\t": "tab", "\x7f": "backspace", "\x08": "backspace",
                         "\x03": "q"}.get(ch, ch))
            i += 1
    return keys


def nav_ids(m, vs):
    if vs.focus == "now":
        return [r["id"] for r in now_list(m, vs)]
    return [r["id"] for r in results_list(m, vs)[0]]


def handle_key(vs, m, key):
    """vs を更新し、副作用が要る場合は action 名 (quit / tail / tails / reload) を返す。"""
    if key == "q":
        return "quit"
    if vs.help:
        vs.help = False
        return None
    if key == "?":
        vs.help = True
        return None
    if vs.view in ("detail", "results"):
        if key in ("esc", "backspace") or (vs.view == "results" and key == "r"):
            vs.view, vs.scroll = "main", 0
        elif key in ("j", "down"):
            vs.scroll += 1
        elif key in ("k", "up"):
            vs.scroll = max(0, vs.scroll - 1)
        elif key == "g":
            vs.scroll = 0
        elif key == "G":
            vs.scroll = vs.max_scroll
        elif key == "R":
            return "reload"
        return None
    ids = nav_ids(m, vs)
    cur = sel_id(vs, vs.focus, ids)
    if key in ("j", "down", "k", "up") and ids:
        i = ids.index(cur) + (1 if key in ("j", "down") else -1)
        vs.sel[vs.focus] = ids[max(0, min(len(ids) - 1, i))]
    elif key in ("g", "G") and ids:
        vs.sel[vs.focus] = ids[0] if key == "g" else ids[-1]
    elif key == "tab":
        vs.focus = "results" if vs.focus == "now" else "now"
    elif key == "enter" and cur:
        vs.view, vs.detail_id, vs.scroll = "detail", cur, 0
    elif key == "a":
        vs.show_all = not vs.show_all
    elif key == "f":
        now_n = vs.feed_n if vs.feed_n is not None else feed_count(vs, vs.term_w)
        i = FEED_CYCLE.index(now_n) if now_n in FEED_CYCLE else 0
        vs.feed_n = FEED_CYCLE[(i + 1) % len(FEED_CYCLE)]
    elif key == "e":
        vs.only_err = not vs.only_err
    elif key == "p":
        vs.strip = not vs.strip
    elif key == "r":
        vs.view, vs.scroll = "results", 0
    elif key == "R":
        return "reload"
    elif key == "t" and cur:
        return "tail"
    elif key == "T":
        return "tails"
    return None


def diff_output(prev, lines, full=False):
    """前フレームとの差分を端末出力文字列にする。全行同一なら空文字 (書かない)。"""
    if prev is None or full or len(prev) != len(lines):
        return "\x1b[H" + "\r\n".join(l + "\x1b[K" for l in lines) + "\x1b[J"
    return "".join(f"\x1b[{i + 1};1H{b}\x1b[K" for i, (a, b) in enumerate(zip(prev, lines)) if a != b)


def new_notifications(m, notified):
    """遷移通知 [(key, title, body)]。notified (set) に積み、同一イベントは 1 回だけ。"""
    out = []

    def add(key, title, body):
        if key not in notified:
            notified.add(key)
            out.append((key, title, body))
    for r in m.rows:
        if r["state"] == "error":
            add(("error", r["id"]), "ultracode エラー", f"{r['label']} ({r['phase']})")
        elif r["state"] == "stalled":
            add(("stalled", r["id"]), "ultracode 停滞", f"{r['label']} ({r['phase']})")
    if m.finished:
        add(("done",), f"ultracode 完了 ✓{m.counts['done']} ✗{m.counts['error']}", m.name)
    return out


def status_text(m):
    run = [p["name"] for p in m.phases if p["state"] == "running"]
    cur = run[0] if run else ""
    return f"▶{m.counts['running']} ✓{m.finished_n}/{m.seen} {cur}".strip()


# ---------- IO: tail ペイン管理 ----------

class TailPanes:
    """agent id -> 自分が開いた tail pane id。二重起動を防ぎ、終了時に自分の pane だけ閉じる。"""

    def __init__(self, run_dir):
        self.run_dir, self.panes, self.extra = run_dir, {}, []

    def _alive(self, pane_id):
        try:
            hcli("pane", "get", pane_id)
            return True
        except RuntimeError:
            return False

    def open(self, aid):
        """-> "open" / "exists"。失敗は RuntimeError。"""
        pid = self.panes.get(aid)
        if pid and self._alive(pid):
            return "exists"  # herdr に pane id 指定の focus が無いので通知のみ
        pid = split_pane(os.environ.get("HERDR_PANE_ID"), "right")
        try:
            run_in_pane(pid, ["tail", aid, self.run_dir])
        except RuntimeError:
            close_panes([pid])
            raise
        self.panes[aid] = pid
        return "open"

    def close_all(self):
        close_panes(list(self.panes.values()) + self.extra)
        self.panes, self.extra = {}, []


def bg(fn, *args):
    """herdr 呼び出しを描画から切り離す。失敗は握りつぶす。"""
    def run():
        try:
            fn(*args)
        except Exception:  # noqa: BLE001 - 描画を止めない
            pass
    threading.Thread(target=run, daemon=True).start()


def notify(title, body):
    try:
        hcli("notification", "show", title, "--body", body, "--sound", "done")
    except RuntimeError:
        pass


# ---------- サブコマンド ----------

def term_size(width_arg=None):
    size = shutil.get_terminal_size((100, 30))
    return (width_arg or size.columns), size.lines


def dashboard_once(reader, args):
    width, _ = term_size(args.width)
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    m = reader.model(time.time())
    vs = ViewState(show_all=args.all, results_cap=None if args.all else ONCE_RESULTS_CAP)
    print("\n".join(render_frame(m, vs, width, 10 ** 6, 0, color)))
    return 0


def dashboard_live(reader, args):
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    out = sys.stdout
    restored = []
    tails = TailPanes(reader.run_dir)
    rpipe, wpipe = os.pipe()
    os.set_blocking(rpipe, False)
    os.set_blocking(wpipe, False)

    def restore():
        if restored:
            return
        restored.append(1)
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
            out.write("\x1b[?25h\x1b[?1049l")
            out.flush()
        except (termios.error, OSError, ValueError):
            pass
        tails.close_all()

    atexit.register(restore)
    color = not os.environ.get("NO_COLOR")
    vs = ViewState(interactive=True)
    notified, stall_seen, stall_events = set(), set(), []
    prev, prev_size, frame, next_tick, last_meta, idle_since, first = None, None, 0, 0.0, 0.0, None, True
    action, want_reload = None, False
    try:
        tty.setcbreak(fd)
        out.write("\x1b[?1049h\x1b[?25l")
        if hasattr(signal, "SIGWINCH"):
            def on_winch(*_):
                try:
                    os.write(wpipe, b"w")
                except OSError:
                    pass
            signal.signal(signal.SIGWINCH, on_winch)
        keys = []
        while True:
            now = time.time()
            if now >= next_tick or want_reload:
                reader.snapshot()
                if want_reload:
                    reader.workflow_meta(force=True)
                next_tick, frame, want_reload = now + POLL_SEC, frame + 1, False
            m = reader.build(now, stall_events)
            fresh = [(now, r["id"]) for r in m.rows if r["state"] == "stalled" and r["id"] not in stall_seen]
            stall_seen = {r["id"] for r in m.rows if r["state"] == "stalled"} | {i for _, i in fresh}
            if fresh:
                stall_events += fresh
                m = reader.build(now, stall_events)
            notes = new_notifications(m, notified)
            if first:  # 起動時点で既にある状態は通知しない
                first = False
            else:
                for _, title, body in notes:
                    bg(notify, title, body)
            if now - last_meta >= META_INTERVAL_SEC:
                last_meta = now
                bg(report_status, status_text(m), "✗ ultra" if m.has_alert else None)
            for key in keys:
                action = handle_key(vs, m, key)
                if action == "quit":
                    return 0
                if action == "reload":
                    want_reload, next_tick = True, 0.0
                if action == "tail":
                    ids = nav_ids(m, vs)
                    aid = sel_id(vs, vs.focus, ids)
                    try:
                        vs.msg = "tail " + ("を開いた" if tails.open(aid) == "open" else "は既に開いている")
                    except RuntimeError as e:
                        vs.msg = f"tail 失敗: {e}"[:80]
                    vs.msg_until = time.time() + 3
                elif action == "tails":
                    try:
                        created = open_tails(reader.run_dir, 4)
                        tails.extra += created
                        vs.msg = "tail tab を開いた" if created else "実行中 agent なし"
                    except RuntimeError as e:
                        vs.msg = f"tails 失敗: {e}"[:80]
                    vs.msg_until = time.time() + 3
            keys = []
            idle_since = next_idle_since(m.counts, idle_since, now)
            if idle_expired(idle_since, now):
                return 0
            size = shutil.get_terminal_size((100, 30))
            vs.term_w = size.columns
            lines = render_frame(m, vs, size.columns, size.lines, frame, color)
            chunk = diff_output(prev, lines, prev_size != size)
            if chunk:
                out.write(chunk)
                out.flush()
            prev, prev_size = lines, size
            r, _, _ = select.select([fd, rpipe], [], [], max(0.0, next_tick - time.time()))
            if rpipe in r:
                try:
                    os.read(rpipe, 64)
                except OSError:
                    pass
                prev = None
            if fd in r:
                keys = parse_keys(os.read(fd, 64).decode("utf-8", "ignore"))
    except KeyboardInterrupt:
        return 0
    finally:
        restore()


def cmd_dashboard(args):
    run_dir = resolve_run_dir(args.run)
    if not run_dir:
        print("run dir が見つからない", file=sys.stderr)
        return 2
    reader = RunReader(run_dir)
    if args.once or not (sys.stdout.isatty() and sys.stdin.isatty()):
        return dashboard_once(reader, args)
    return dashboard_live(reader, args)


def cmd_tail(args):
    run_dir = resolve_run_dir(args.run)
    if not run_dir:
        print("run dir が見つからない", file=sys.stderr)
        return 2
    reader = RunReader(run_dir)
    aid = resolve_agent(reader.journal(), args.agent)
    if not aid:
        print(f"agent を一意に特定できない: {args.agent}", file=sys.stderr)
        return 2
    path, first = os.path.join(run_dir, f"agent-{aid}.jsonl"), True
    while True:
        width = shutil.get_terminal_size((100, 30)).columns
        lines = []
        for raw in reader.new_lines(path):
            try:
                lines += format_event(json.loads(raw), width)
            except ValueError:
                continue
        if first:
            lines = lines[-args.lines:]
        if lines:
            print("\n".join(lines), flush=True)
        first = False
        if args.no_follow:
            return 0
        time.sleep(POLL_SEC)


def open_dashboard(run_dir, pane=None, per_agent=0):
    """dashboard を split ペインで開く。per_agent>0 なら実行中 agent の tail を新 tab に並べる。"""
    new_pane = split_pane(pane or os.environ.get("HERDR_PANE_ID"), "right")
    try:
        run_in_pane(new_pane, ["dashboard", run_dir])
    except RuntimeError:
        close_panes([new_pane])
        raise
    if per_agent > 0 and not open_tails(run_dir, per_agent):
        print("実行中 agent なし: tail ペインは開かない")


def open_tails(run_dir, limit):
    agents, stats = RunReader(run_dir).snapshot()
    now = time.time()
    running = [aid for aid, a in agents.items() if agent_state(a, stats.get(aid), now) == "running"][:limit]
    if not running:
        return []
    ws = os.environ.get("HERDR_WORKSPACE_ID")
    pane = find_key(hcli("tab", "create", "--label", f"ultra:{os.path.basename(run_dir)[-8:]}", "--no-focus",
                         *(["--workspace", ws] if ws else [])), "pane_id")
    if not pane:
        raise RuntimeError("tab create の応答に pane_id が無い")
    created = [pane]
    try:
        for i, aid in enumerate(running):
            if i:
                pane = split_pane(pane, "down" if i % 2 else "right")
                created.append(pane)
            run_in_pane(pane, ["tail", aid, run_dir])
    except RuntimeError:
        close_panes(created)
        raise
    return created


def cmd_open(args):
    run_dir = resolve_run_dir(args.run)
    if not run_dir:
        print("run dir が見つからない", file=sys.stderr)
        return 2
    if not in_herdr() and not args.pane:
        print("herdr 内で実行するか --pane を指定する", file=sys.stderr)
        return 2
    open_dashboard(run_dir, args.pane, args.per_agent)
    return 0


def open_claimed(run_dir, pane=None):
    """run を claim して dashboard を開く。再試行不要 (開けた / 他が claim 済み) なら True、失敗なら False。"""
    run_id = os.path.basename(run_dir)
    try:
        if not claim_run(run_id):
            return True
    except OSError as e:
        print(f"claim 失敗: {e}", file=sys.stderr)
        return False
    try:
        open_dashboard(run_dir, pane)
    except (RuntimeError, OSError, ValueError) as e:
        release_run(run_id)
        print(f"open 失敗: {e}", file=sys.stderr)
        return False
    return True


def cmd_hook(args):
    """PostToolUse(Workflow) 用: stdin の hook JSON から run を特定して open。失敗は黙って 0。"""
    try:
        run_dir = locate_from_hook(json.load(sys.stdin))
        if run_dir and in_herdr():
            open_claimed(run_dir)
    except (ValueError, RuntimeError, OSError):
        pass
    return 0


def handle_new_run(run_dir, print_only):
    """新 run の dashboard を開く。再試行不要なら True、pane 未解決 / open 失敗なら False。"""
    run_id, sid = os.path.basename(run_dir), session_id_of(run_dir)
    pane = None
    try:
        pane = owner_pane(sid, hcli("agent", "list").get("agents", [])) if sid else None
    except RuntimeError:
        pass
    print(f"new run {run_id} session={sid} pane={pane}", flush=True)
    if print_only:
        return True
    return bool(pane) and open_claimed(run_dir, pane)


def cmd_daemon(args):
    known = set() if args.include_existing else set(find_run_dirs())
    first_seen = {}  # 未完了 (再試行中) の run -> 初検出時刻
    print(f"watching {projects_dir()} (Ctrl-C で終了)", flush=True)
    while True:
        now = time.time()
        for run_dir in new_runs(known, find_run_dirs()):
            first = first_seen.setdefault(run_dir, now)
            if handle_new_run(run_dir, args.print_only) or retry_expired(first, now):
                known.add(run_dir)
                first_seen.pop(run_dir)
        time.sleep(args.interval)


def build_parser():
    p = argparse.ArgumentParser(prog="herdr-ultra-watch", description="ultracode (Workflow) 実行の可視化")
    sub = p.add_subparsers(dest="cmd", required=True)

    def run_arg(sp):
        sp.add_argument("run", nargs="?", help="run dir か run id。省略時は最新")
        sp.add_argument("--latest", action="store_true", help="最新の run (省略時の既定動作)")

    d = sub.add_parser("dashboard", help="phase/agent の進捗をライブ表示")
    run_arg(d)
    d.add_argument("--once", action="store_true", help="1 回描画して終了 (非 TTY も同じ)")
    d.add_argument("--width", type=int, help="静的出力の幅 (既定: COLUMNS / 端末幅)")
    d.add_argument("--all", action="store_true", help="静的出力で完了 agent を全件出す")
    d.set_defaults(fn=cmd_dashboard)

    t = sub.add_parser("tail", help="1 agent の transcript を追従表示")
    t.add_argument("agent", help="agent id (前方一致) か label")
    t.add_argument("run", nargs="?", help="run dir か run id。省略時は最新")
    t.add_argument("--lines", type=int, default=20, help="最初に出す直近イベント数")
    t.add_argument("--no-follow", action="store_true", help="既存分だけ出して終了")
    t.set_defaults(fn=cmd_tail)

    o = sub.add_parser("open", help="herdr ペインで dashboard を開く")
    run_arg(o)
    o.add_argument("--per-agent", type=int, default=0, metavar="N", help="実行中 agent の tail を新 tab に最大 N 個")
    o.add_argument("--pane", help="split 元ペイン (既定: HERDR_PANE_ID / current)")
    o.set_defaults(fn=cmd_open)

    dm = sub.add_parser("daemon", help="新しい run を監視して dashboard を自動で開く (opt-in)")
    dm.add_argument("--interval", type=float, default=5.0)
    dm.add_argument("--print-only", action="store_true", help="開かず検出のみ表示")
    dm.add_argument("--include-existing", action="store_true", help="起動時点の既存 run も対象にする")
    dm.set_defaults(fn=cmd_daemon)

    h = sub.add_parser("hook", help="PostToolUse(Workflow) hook JSON を stdin から受けて open")
    h.set_defaults(fn=cmd_hook)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except KeyboardInterrupt:
        return 130
    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
