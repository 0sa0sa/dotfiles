def render_help(vs, w, h, color):
    rows = [[("◆ ", "1;36"), ("キー操作", "1;36")], rule("ヘルプ", w)]
    rows += [[(" " + pad(k, 16), "36"), (v, "")] for k, v in HELP_LINES]
    rows = rows[:max(1, h - 1)] + [[(" 何かキーで戻る", "2")]]
