def render_scrolled(vs, w, h, color, rows, hint):
    body_h = max(1, h - 1)
    vs.max_scroll = max(0, len(rows) - body_h)
    vs.scroll = max(0, min(vs.scroll, vs.max_scroll))
    view = rows[vs.scroll:vs.scroll + body_h]
    foot = f" {hint}  ({vs.scroll + 1}-{min(len(rows), vs.scroll + body_h)}/{len(rows)})"
    return [to_line(r, w, color) for r in view] + [to_line([(foot, "2")], w, color)]


