def format_event(ev, width):
    """transcript 1 行 -> 表示行のリスト (assistant の text / tool_use のみ)。"""
    msg = ev.get("message")
    if ev.get("type") != "assistant" or not isinstance(msg, dict):
        return []
    ts = parse_ts(ev.get("timestamp"))
    stamp = time.strftime("%H:%M:%S", time.localtime(ts)) if ts else "--:--:--"
    out = []
    for block in msg.get("content") or []:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "text" and block.get("text", "").strip():
            out.append(clip(f"{stamp}  {block['text'].strip().splitlines()[0]}", width))
        elif block.get("type") == "tool_use":
            hint = tool_hint(block.get("input"))
            out.append(clip(f"{stamp}  > {block.get('name')} {hint}".rstrip(), width))
    return out


