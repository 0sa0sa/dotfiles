def session_id_of(run_dir):
    """<proj>/<session-uuid>/subagents/workflows/<run> から session id を取る。無ければ None。"""
    parts = os.path.normpath(run_dir).split(os.sep)
    if len(parts) >= 5 and parts[-2] == "workflows" and parts[-3] == "subagents" and UUID_RE.match(parts[-4]):
        return parts[-4]
    return None


def find_run_dirs(base=None):
    """journal.jsonl を持つ run dir を更新が新しい順に返す。"""
    base = base or projects_dir()
    pats = [os.path.join(base, "*", "*", "subagents", "workflows", "wf_*"),
            os.path.join(base, "*", "subagents", "workflows", "wf_*")]
    dirs = {d for p in pats for d in glob.glob(p) if os.path.exists(os.path.join(d, "journal.jsonl"))}
    return sorted(dirs, key=lambda d: os.path.getmtime(os.path.join(d, "journal.jsonl")), reverse=True)


def resolve_run_dir(arg, base=None):
    """パス / run id / None(=最新) -> run dir。見つからなければ None。"""
    if arg and os.path.isdir(arg):
        return os.path.abspath(arg)
    runs = find_run_dirs(base)
    if not arg:
        return runs[0] if runs else None
    return next((d for d in runs if os.path.basename(d) == arg), None)


def resolve_agent(agents, query):
    """agent id (前方一致) か label (完全一致) -> agent_id。曖昧/なしは None。"""
    hits = [aid for aid, a in agents.items() if aid == query or a["label"] == query]
    hits = hits or [aid for aid in agents if aid.startswith(query)]
    return hits[0] if len(hits) == 1 else None


def locate_from_hook(payload, base=None):
    """PostToolUse hook JSON -> run dir。tool_response 内の run id、無ければ session の最新 run。"""
    m = RUN_ID_RE.search(json.dumps(payload.get("tool_response", "")))
    if m:
        found = resolve_run_dir(m.group(0), base)
        if found:
            return found
    sid = payload.get("session_id")
    runs = [d for d in find_run_dirs(base) if sid and session_id_of(d) == sid]
    return runs[0] if runs else None


def new_runs(known, current):
    return [d for d in current if d not in known]


def owner_pane(session_id, agents):
    """herdr agent list の結果から session id を持つ pane id を返す。"""
    for a in agents:
        if (a.get("agent_session") or {}).get("value") == session_id:
            return a.get("pane_id")
    return None


def find_key(obj, key):
    """入れ子の dict/list から最初の key の値を探す (herdr 応答の形差分に耐える)。"""
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        obj = list(obj.values())
    if isinstance(obj, list):
        for v in obj:
            r = find_key(v, key)
            if r is not None:
                return r
    return None


