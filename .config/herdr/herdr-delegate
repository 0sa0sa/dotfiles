)


def build_worker_settings(hook_command, deny):
    """claude --settings 用 dict: Stop hook (終了契約) と permissions.deny (フロア)."""
    settings = {"hooks": {"Stop": [{"hooks": [{"type": "command", "command": hook_command}]}]}}
    if deny:
        settings["permissions"] = {"deny": list(deny)}
    return settings


def write_worker_settings(task_dir, deny):
    import shlex

    path = os.path.join(task_dir, "worker-settings.json")
    atomic_write_json(path, build_worker_settings(f"python3 {shlex.quote(STOP_HOOK)}", deny))
    return path


def build_wrapper(task_dir, agent, model, safe, cwd, settings=None):
    import shlex

    prompt_path = os.path.join(task_dir, "prompt.md")
    model_part = MODEL_FLAGS[agent].format(m=shlex.quote(model)) if model else ""
    danger_part = "" if safe else DANGER_FLAGS[agent]
    settings_part = f"--settings {shlex.quote(settings)}" if settings else ""
    agent_cmd = AGENT_CMDS[agent].format(model=model_part, danger=danger_part,
                                         settings=settings_part)
    wrapper = tempfile.NamedTemporaryFile(
        "w", delete=False, prefix="herdr-delegate-", suffix=".sh"
    )
    wrapper.write("#!/usr/bin/env bash\nset -euo pipefail\n")
    wrapper.write(f"cwd={shlex.quote(cwd)}\n")
    wrapper.write(f"export HERDR_DELEGATE_TASK_DIR={shlex.quote(task_dir)}\n")
    wrapper.write(f"export HERDR_DELEGATE_RESULT={shlex.quote(os.path.join(task_dir, 'result.md'))}\n")
    wrapper.write(f'prompt="$(cat {shlex.quote(prompt_path)})"\n')
    wrapper.write('rm -f -- "$0"\n')
    wrapper.write(f'cd "$cwd"\n{agent_cmd}\n')
    wrapper.close()
    os.chmod(wrapper.name, 0o755)
    return wrapper.name


def open_pane(args, task_id, cwd):
    """worker 用 pane を作る。戻り値: pane 情報 dict (cwd は worktree なら worktree パス)."""
    if args.worktree is not None:
        branch = args.worktree or f"delegate/{task_id}"
        wt = hcli("worktree", "create", "--cwd", cwd,
                  "--branch", branch, "--json", "--no-focus")
        # probe 実測 (2026-07-10, herdr 0.7.1): brief の想定キー
        # (wt["path"] / wt["workspace_id"]) は存在しない。実際の応答は
        # {"root_pane": {pane_id, tab_id, workspace_id, ...},
        #  "tab": {...}, "workspace": {...},
        #  "worktree": {branch, path, open_workspace_id, ...}} 形。
        # root_pane に pane_id/tab_id/workspace_id が同梱されている点は
        # tab create の root_pane fallback と同型なので pane.list は不要。
        root = wt["root_pane"]
        return {"pane_id": root["pane_id"], "tab_id": root["tab_id"],
                "workspace_id": root["workspace_id"], "cwd": wt["worktree"]["path"],
                "worktree_path": wt["worktree"]["path"], "worktree_branch": branch}
    ws = current_workspace_id()
    tab = hcli("tab", "create", "--workspace", ws, "--cwd", cwd,
               "--label", task_id, "--no-focus")
    # probe 実測 (2026-07-10, herdr 0.7.1): tab create の応答に
    # root_pane が直接含まれる（pane_id/tab_id 込み）。pane.list による
    # tab_id 一致検索は不要だが、将来のスキーマ変化に備え fallback を残す。
    tab_id = tab["tab"]["tab_id"] if "tab" in tab else tab["tab_id"]
    if "root_pane" in tab:
        pane_id = tab["root_pane"]["pane_id"]
    else:
        panes = call("pane.list", {"workspace_id": ws})["panes"]
        pane_id = next(p for p in panes if p["tab_id"] == tab_id)["pane_id"]
    return {"pane_id": pane_id, "tab_id": tab_id, "workspace_id": ws, "cwd": cwd,
            "worktree_path": None, "worktree_branch": None}


def start_worker(args, task_dir, pane, settings=None):
    wrapper = build_wrapper(task_dir, args.agent, args.model, args.safe, pane["cwd"], settings)
    proc = subprocess.run(["herdr", "pane", "run", pane["pane_id"], f"bash {wrapper}"],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        with contextlib.suppress(OSError):
            os.unlink(wrapper)
        raise RuntimeError(f"herdr pane run failed: {proc.stderr.strip()}")
    call("pane.rename", {"pane_id": pane["pane_id"], "label": os.path.basename(task_dir)})


def spawn_output(task_id, pane_id, task_dir, **extra):
    return json.dumps({"task_id": task_id, "pane_id": pane_id,
                       "task_dir": task_dir, **extra}, ensure_ascii=False)


def idem_guard(args, prompt_body):
    """--idempotency-key の処理。既存なら出力して None、新規なら idem パス、キー無しは ""."""
    if not args.idempotency_key:
        return ""
    gc_idem()
    verdict, info = claim_idem(args.idempotency_key, prompt_sha(prompt_body), args.agent)
    if verdict == "new":
        return info
    if verdict == "conflict":
        raise ConfigError(f"idempotency-key '{args.idempotency_key}' は別 prompt で使用済み")
    if verdict == "in_progress":
        raise ConfigError(f"idempotency-key '{args.idempotency_key}' の spawn が進行中/中断")
    task_dir = task_dir_of(info["task_id"])
    m = load_manifest(task_dir)
    print(spawn_output(info["task_id"], m["pane_id"], task_dir,
                       state=effective_state(m), existing=True))
    return None


def cmd_spawn(args):
    prompt_body = args.prompt or open(args.prompt_file).read()
    cwd = os.path.abspath(args.cwd or os.getcwd())
    check_gate_args(args)
    args.agent, args.fallback_from = resolve_agent(args.agent)
    problems = preflight_problems(args.agent, cwd, worktree=args.worktree is not None)
    if problems:
        raise ConfigError("preflight 失敗: " + "; ".join(problems))
    args.mission = resolve_mission(getattr(args, "mission", None))
    idem = idem_guard(args, prompt_body)
    if idem is None:
        return
    try:
        task_id = create_task(args, prompt_body, cwd)
    except BaseException:
        if idem:
            release_idem(idem)
        raise
    if idem:
        finish_idem(idem, task_id)


def check_gate_args(args):
    if args.gate_retries < 1 or args.gate_timeout < 1:
        raise ConfigError("--gate-retries/--gate-timeout は 1 以上")


def load_schema(path):
    """--schema FILE を読む (未指定は None)。読めない/オブジェクトでないなら ConfigError."""
    if not path:
        return None
    try:
        with open(path) as f:
            schema = json.load(f)
    except (OSError, ValueError) as e:
        raise ConfigError(f"--schema を読めない: {path} ({e})") from e
    if not isinstance(schema, dict):
        raise ConfigError(f"--schema はオブジェクトであること: {path}")
    return schema


def count_active(manifests, group=None):
    """未終端 task の数。group 指定ならその group のみ."""
    return sum(1 for m in manifests
               if effective_state(m) not in TERMINAL_STATES
               and (group is None or m.get("group") == group))


def check_concurrency(limit, group):
    if limit is None:
        return
    active = count_active([m for _, _, m in iter_manifests()], group)
    if active >= limit:
        scope = f"group {group}" if group else "全体"
        raise ConfigError(f"--max-concurrent {limit} 超過: {scope}で未終端 {active} 件")


def parent_info(task_id):
    """親 task の handoff 情報 (summary / branch / git diff --stat)."""
    d = os.path.join(TASKS_DIR, task_id)
    if not os.path.isfile(os.path.join(d, "manifest.json")):
        raise ConfigError(f"--parent: 未知の task {task_id}")
    m = load_manifest(d)
    res = load_result(d)
    base = m.get("base_commit")
    return {
        "task_id": task_id,
        "summary": res["summary"] if res else "(result なし)",
        "artifacts": res["artifacts"] if res else [],
        "branch": m.get("worktree_branch"),
        "diffstat": run_git(m["cwd"], "diff", "--stat", base) if base else None,
    }


def format_parent_section(parents):
    """prompt 先頭に置く「## Parent task results」(空なら "")."""
    if not parents:
        return ""
    out = ["## Parent task results"]
    for p in parents:
        out.append(f"### {p['task_id']}" + (f" (branch: {p['branch']})" if p["branch"] else ""))
        out.append(p["summary"] or "(summary なし)")
        if p["artifacts"]:
            out.append("artifacts: " + ", ".join(p["artifacts"]))
        if p["diffstat"]:
            out.append("git diff --stat:\n" + p["diffstat"])
    return "\n\n".join(out) + "\n\n<!-- /herdr-delegate:parent -->\n\n---\n\n"


def build_manifest(args, task_id, pane, settings, deny, schema, parent_ids, snapshot_pre=None):
    now = now_iso()
    return {
        "task_id": task_id, "agent": args.agent, "model": args.model,
        "pane_id": pane["pane_id"], "tab_id": pane["tab_id"],
        "workspace_id": pane["workspace_id"], "cwd": pane["cwd"],
        "worktree_path": pane["worktree_path"],
        "worktree_branch": pane["worktree_branch"], "label": args.label,
        "created_at": now, "safe": args.safe,
        "group": args.group, "mission": getattr(args, "mission", None), "parents": parent_ids, "schema": bool(schema),
        "worker_settings": settings, "deny_floor": deny,
        "contract": build_contract(args.verify, args.constraints, args.stop_when),
        "gates": list(args.gate or []), "gate_timeout": args.gate_timeout,
        "gate_retries": args.gate_retries, "fallback_from": args.fallback_from,
        "snapshot_pre": snapshot_pre,
        "state": "running", "finished_at": None, "exit_reason": None,
        "delivered_at": None, "base_commit": run_git(pane["cwd"], "rev-parse", "HEAD"),
        "events": [{"ts": now, "kind": "state", "state": "running", "detail": "spawn"}],
    }


def rollback_spawn(pane, task_dir):
    """spawn 失敗時に作った pane (worktree なら workspace ごと) と task dir を片付ける.

    manifest が無いと doctor/kill から見えず孤児になるため。後始末の失敗は握りつぶす。
    """
    with contextlib.suppress(Exception):
        if pane["worktree_path"]:
            hcli("worktree", "remove", "--workspace", pane["workspace_id"], "--force")
        else:
            hcli("pane", "close", pane["pane_id"])
    shutil.rmtree(task_dir, ignore_errors=True)


@contextlib.contextmanager
def spawn_lock():
    """並列 spawn の同時実行数チェックと task dir 確保を直列化する flock."""
    os.makedirs(TASKS_DIR, exist_ok=True)
    with open(TASKS_DIR.rstrip("/") + ".spawn.lock", "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        yield


def reserve_task(args, prompt_body, cwd):
    """並列数を確認して task dir を作り、仮 manifest (pane 未確定) を置いて task_dir を返す.

    仮 manifest を即置くので、並列 spawn が互いを未終端として数えられる。
    """
    with spawn_lock():
        check_concurrency(args.max_concurrent, args.group)
        task_id = new_task_id(slugify(args.label or prompt_body[:60]), TASKS_DIR)
        task_dir = os.path.join(TASKS_DIR, task_id)
        os.makedirs(task_dir)
        now = now_iso()
        save_manifest(task_dir, {
            "task_id": task_id, "agent": args.agent, "group": args.group, "cwd": cwd,
            "pane_id": None, "tab_id": None, "workspace_id": None, "worktree_path": None,
            "worktree_branch": None, "created_at": now, "state": "running",
            "events": [{"ts": now, "kind": "state", "state": "running", "detail": "reserve"}]})
    return task_dir


ORCH_TIMEOUT = 5


def orch_bin():
    """herdr-orch の場所: env HERDR_ORCH_BIN > 本ファイルと同じ dir > PATH (無ければ None)."""
    env = os.environ.get("HERDR_ORCH_BIN")
    if env:
        return env if os.access(env, os.X_OK) else None
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "herdr-orch")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("herdr-orch")


def run_orch(*argv):
    """herdr-orch を best-effort で呼ぶ。成功時 stdout、失敗/timeout/不在/非0 は None."""
    try:
        binary = orch_bin()
        if not binary:
            return None
        proc = subprocess.run([binary, *argv], capture_output=True, text=True,
                              stdin=subprocess.DEVNULL, timeout=ORCH_TIMEOUT)
        return proc.stdout if proc.returncode == 0 else None
    except Exception:
        return None


def resolve_mission(explicit):
    """--mission > env HERDR_MISSION > `herdr-orch mission current`。無ければ None."""
    mid = next((c for c in (explicit, os.environ.get("HERDR_MISSION")) if c), None) \
        or (run_orch("mission", "current") or "").strip() or None
    if mid and orch_bin() and run_orch("mission", "show", mid) is None:
        # typo だと context に mission 節が出ず紐付かない。保存はするが警告
        print(f"herdr-delegate: 警告: mission '{mid}' が herdr-orch に見つからない", file=sys.stderr)
    return mid


def orch_context(args, task_id, prompt_body):
    """prompt に挿入する herdr-orch context (無効/失敗/空は "")."""
    if getattr(args, "no_orch_context", False):
        return ""
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(prefix="herdr-orch-prompt-", suffix=".md")
        with os.fdopen(fd, "w") as f:
            f.write(prompt_body)
        argv = ["context", "--agent", args.agent, "--task", task_id, "--prompt-file", tmp]
        if args.group:
            argv += ["--group", args.group]
        if getattr(args, "mission", None):
            argv += ["--mission", args.mission]
        return (run_orch(*argv) or "").strip()
    except Exception:
        return ""
    finally:
        if tmp:
            with contextlib.suppress(OSError):
                os.unlink(tmp)


def orch_after_outcome(task_id, state, manifest, summary):
    """終端後の学習フック: lessons capture と group ボードへの done 投稿 (全て best-effort)."""
    if state not in ("done", "killed"):
        run_orch("lessons", "capture", task_id)
    group = manifest.get("group")
    if group:
        line = (summary or "").strip().splitlines()[:1]
        run_orch("board", "post", group, "--task", task_id, "--kind", "done",
                 f"{state}: {line[0] if line else ''}")


def create_task(args, prompt_body, cwd):
    schema = load_schema(args.schema)
    parent_ids = [x for x in (args.parent or "").split(",") if x]
    parents = [parent_info(t) for t in parent_ids]

    task_dir = reserve_task(args, prompt_body, cwd)
    task_id = os.path.basename(task_dir)
    try:
        if schema:
            atomic_write_json(os.path.join(task_dir, "schema.json"), schema)
        with open(os.path.join(task_dir, "prompt.md"), "w") as f:
            ctx = orch_context(args, task_id, prompt_body)
            f.write(format_parent_section(parents) + prompt_body.rstrip() + "\n"
                    + (ctx + "\n" if ctx else "")
                    + contract_footer(task_dir, schema,
                                      build_contract(args.verify, args.constraints, args.stop_when)))
        deny = [] if args.no_deny_floor or args.agent != "claude" else list(DENY_FLOOR)
        settings = write_worker_settings(task_dir, deny) if args.agent == "claude" else None
        pane = open_pane(args, task_id, cwd)
    except BaseException:
        shutil.rmtree(task_dir, ignore_errors=True)  # 仮 manifest が未終端として残らないように
        raise
    try:
        pre = snapshot_pre(args, pane, task_id)
        start_worker(args, task_dir, pane, settings)
        with manifest_lock(task_dir):  # 並行する reconcile の書き戻しと競合させない
            save_manifest(task_dir, build_manifest(args, task_id, pane, settings, deny,
                                                   schema, parent_ids, pre))
    except BaseException:
        delete_snapshot_refs(pane["cwd"], task_id)
        rollback_spawn(pane, task_dir)
        raise
    report_pane_state(pane["pane_id"], "running", args.label or task_id)
    print(spawn_output(task_id, pane["pane_id"], task_dir))
    return task_id


POLL_SECS = 5
WAIT_SLICE_MS = 10_000  # herdr 側ブロッキング待ちの1回あたり上限 (blocked 検知の遅延上限)
NUDGE_TEXT = "委任契約を確認: 完了しているなら {result} に status/summary/artifacts を書くこと。"

# 一回限りの trust-dialog 検出用: pane の可視テキストにこの部分文字列
# (小文字比較) が含まれていたら、確認プロンプト待ちとみなし Return を1回送る。
# 実測 (2026-07-10, claude CLI, herdr 0.7.1, 本 Task 3 のスモークテスト):
# 実際の文言は以下 (フォルダ初回アクセス時の一回限りのダイアログ):
#   "Quick safety check: Is this a project you created or one you trust?"
#   "... take a moment to review what's in this folder first."
#   "Claude Code'll be able to read, edit, and execute files here."
#   選択肢: "1. Yes, I trust this folder" / "2. No, exit"
# 事前情報 (Task 2 での目視) は agent_status が "unknown" になると想定して
# いたが、本タスクの実測では herdr はこのダイアログ表示中も agent_status
# を "idle" として報告した (working/blocked にはならない)。そのため検出
# チェックは agent_status の値に関係なく毎ループ試みる (下記 cmd_wait 参照)。
# "trust the files in this folder" は claude のバージョン差分に備えた保険。
# "do you trust the contents of this directory" は Task 6 で実測した codex
# 固有の初回ディレクトリ trust ダイアログの文言 (claude とは別文言)。
TRUST_PROMPT_MARKERS = (
    "is this a project you created or one you trust",
    "trust this folder",
    "trust the files in this folder",
    "do you trust the contents of this directory",
)


def is_trust_prompt(text):
    """pane の可視テキストが trust/confirm ダイアログらしいか判定する純関数."""
    if not text:
        return False
    lowered = text.lower()
    return any(marker in lowered for marker in TRUST_PROMPT_MARKERS)


def trust_cursor_on_no(text):
    """trust ダイアログの選択カーソルが "No" 側にあるか判定する純関数。
    新しい claude は初期カーソルが "No, exit" にあり、Return だけだと終了してしまう."""
    return re.search(r"❯\s*(\d+\.\s*)?no\b", text.lower()) is not None


def task_dir_of(task_id):
    d = os.path.join(TASKS_DIR, task_id)
    if not os.path.isdir(d):
        raise SystemExit(f"unknown task: {task_id}")
    return d


def extract_read_text(out):
    """`herdr agent read` の出力から本文を取り出す純関数 (JSON 封筒なら result.read.text、でなければそのまま)."""
    try:
        return json.loads(out)["result"]["read"]["text"]
    except (ValueError, KeyError, TypeError):
        return out


def pane_tail(pane_id, lines=40):
    proc = subprocess.run(
        ["herdr", "agent", "read", pane_id, "--source", "recent-unwrapped",
         "--lines", str(lines)],
        capture_output=True, text=True)
    return extract_read_text(proc.stdout)


def save_recovery(task_dir, state):
    """pane 消失に備えた復旧情報 (pane 末尾20行 + git 状態) を recovery.json に保存."""
    m = load_manifest(task_dir)
    atomic_write_json(os.path.join(task_dir, "recovery.json"), {
        "saved_at": now_iso(), "state": state,
        "pane_tail": pane_tail(m["pane_id"], 20).splitlines()[-20:],
        "git": git_snapshot(m["cwd"]),
    })


def send_line(pane_id, text, retries=1):
    # エコーバック検証窓: 狭い窓 (旧: --lines 5, デフォルト source) だと、
    # haiku 等の速い agent の返信が数行入るだけでエコーが窓外に押し出され
    # 偽陰性 → retry で同一テキストが二重送信される (実測 2026-07-10)。
    # pane_tail() と同じ recent-unwrapped / lines=40 を使うことで、数行の
    # 速い返信が入っても echo が窓内に残る可能性を大幅に上げる (理論上
    # レースを消せるわけではないが、他の一発ワークアラウンド同様の許容
    # レベルに合わせる)。
    for _ in range(retries + 1):
        subprocess.run(["herdr", "agent", "send", pane_id, text],
                       capture_output=True, check=True)
        time.sleep(0.3)
        subprocess.run(["herdr", "pane", "send-keys", pane_id, "enter"],
                       capture_output=True, check=True)
        time.sleep(0.5)
        if text[:20] in pane_tail(pane_id, lines=40):
            return True
    return False


def nudge(pane_id, task_dir):
    return send_line(pane_id, NUDGE_TEXT.format(
        result=os.path.join(task_dir, "result.md")))


def pane_visible(pane_id, lines=20):
    proc = subprocess.run(
        ["herdr", "agent", "read", pane_id, "--source", "visible",
         "--lines", str(lines)],
        capture_output=True, text=True)
    return extract_read_text(proc.stdout)


OBSERVE_RETRIES = 3


def observe_pane(pane_id):
    """get_pane を一時的な herdr 不達に対して数回リトライする。尽きたら終了コード 8."""
    for attempt in range(OBSERVE_RETRIES):
        try:
            return get_pane(pane_id)
        except HerdrUnavailable as e:
            if attempt == OBSERVE_RETRIES - 1:
                die(e, EXIT_CONFIG)
            time.sleep(POLL_SECS)


def die(msg, code):
    print(f"herdr-delegate: {msg}", file=sys.stderr)
    sys.exit(code)


def wait_step(pane_id, status, deadline):
    """次の観測までの待機。working 中は herdr のブロッキング待ち (idle 遷移で即復帰)、
    それ以外・herdr 側待機が失敗した場合は POLL_SECS の sleep にフォールバック."""
    if status == "working":
        remaining = (deadline - time.time()) if deadline else WAIT_SLICE_MS / 1000
        ms = int(max(1, min(WAIT_SLICE_MS, remaining * 1000)))
        t0 = time.monotonic()
        try:
            proc = subprocess.run(
                ["herdr", "wait", "agent-status", pane_id, "--status", "idle",
                 "--timeout", str(ms)], capture_output=True, timeout=ms / 1000 + 5)
        except (OSError, subprocess.TimeoutExpired):
            proc = None
        # rc=0 は idle 遷移、rc!=0 でもほぼ待ち切っていれば正常な timeout。
        # 即失敗 (未対応/エラー) のときだけ sleep にフォールバックする。
        if proc is not None and (proc.returncode == 0 or time.monotonic() - t0 >= ms / 1000 * 0.8):
            return
    time.sleep(POLL_SECS)


TRUST_CURSOR_ATTEMPTS = 3


def maybe_trust_dialog(pane_id):
    """trust ダイアログが出ていれば「信頼する」を選んで Return を1回送り True.
    カーソルが No 側なら Down を送って移動を再読込で確認してから Return する (入力取りこぼし対策)."""
    visible = pane_visible(pane_id)
    if not is_trust_prompt(visible):
        return False
    for _ in range(TRUST_CURSOR_ATTEMPTS):
        if not trust_cursor_on_no(visible):
            break
        subprocess.run(["herdr", "pane", "send-keys", pane_id, "Down"], capture_output=True)
        time.sleep(0.5)
        visible = pane_visible(pane_id)
    subprocess.run(["herdr", "pane", "send-keys", pane_id, "Return"], capture_output=True)
    return True


def notify(title, body):
    subprocess.run(["herdr", "notification", "show", title, "--body", body],
                   capture_output=True)


def result_summary(task_dir, m):
    """結果の summary / artifacts (絶対パス化) / kind を dict で返す (結果なしは空)."""
    res = load_result(task_dir)
    if not res:
        return {}
    out = {"summary": res["summary"],
           "artifacts": [a["path"] or a["raw"]
                         for a in resolve_artifacts(res["artifacts"], m.get("cwd") or task_dir)]}
    if res["status"] == "blocked":
        out["kind"] = normalize_kind(res["kind"])
        if res["question"]:
            out["question"] = res["question"]
    return out


def record_outcome(w, action):
    """終了アクションを台帳に記録し、出力 dict と終了コードを返す (stderr に pane 末尾も出す)."""
    state, code = OUTCOMES[action]
    task_dir, status = w.task_dir, w.status
    info = result_summary(task_dir, w.manifest)
    detail = f"wait: agent_status={status}"
    if "kind" in info:
        detail += f" kind={info['kind']}"
    elif action == "BLOCKED":
        info["kind"] = normalize_kind(None)
        if w.forced_block:
            info["question"] = w.forced_block
    transition(task_dir, state, detail=detail, pane_alive=action != "PANE_GONE",
               exit_reason=EXIT_REASONS.get(action))
    snapshot_post(task_dir)
    out = {"task_id": w.task_id, "status": PUBLIC_STATUS.get(state, state), "state": state}
    if action in ("DONE", "FAILED_RESULT", "GATE_FAILED"):
        res = load_result(task_dir)
        out["result"] = os.path.join(task_dir, res["source"] if res else "result.md")
    elif action == "PANE_GONE":
        out["reason"] = "pane gone"
    elif action in ("TIMEOUT", "QUIET"):
        out["agent_status"] = status
    elif action == "PROTOCOL_VIOLATION":
        out["reason"] = "Stop hook の催促を使い切っても result の status 行なし"
    if action == "GATE_FAILED":
        out.update(reason="gate_failed", gate=w.gate_failure)
        notify(f"delegate {w.task_id} gate 失敗", f"gate が {w.gate_failure['retries']} 回失敗: "
               f"{w.gate_failure['cmd']}")
    elif action == "LIMITED":
        health = with_limit(load_health(), w.manifest["agent"], w.limit_info, time.time())
        save_health(health)
        out.update(reason=w.limit_info["reason"],
                   until=epoch_iso(health[w.manifest["agent"]]["until"]))
        notify(f"delegate {w.task_id} 枠切れ", f"{w.manifest['agent']}: {w.limit_info['reason']}")
    if action == "BLOCKED":
        out.update({k: info[k] for k in ("kind", "question") if k in info})
        notify(f"delegate {w.task_id} blocked", "サブエージェントが入力待ち")
    if action in ("BLOCKED", "STALLED", "TIMEOUT", "QUIET", "PROTOCOL_VIOLATION", "LIMITED"):
        print(pane_tail(w.pane_id), file=sys.stderr)
    orch_after_outcome(w.task_id, state, w.manifest, info.get("summary") or info.get("question")
                       or out.get("reason"))
    return out, code


class Watcher:
    """1 task の wait 状態 (催促回数・idle 開始・進捗監視)。tick() が1回観測して判定を返す."""

    def __init__(self, task_id, args):
        self.task_id = task_id
        self.task_dir = task_dir_of(task_id)
        self.manifest = load_manifest(self.task_dir)
        self.pane_id = self.manifest["pane_id"]
        self.stall_secs, self.stall_grace = args.stall_secs, args.stall_grace
        self.deadline = time.time() + args.timeout / 1000 if args.timeout else None
        self.notified = bool(self.manifest.get("stall_notified_at"))
        self.nudges = 0
        self.idle_since = None
        self.trust_tried = False
        self.progress = ProgressWatch(time.time())
        self.status = None
        self.forced_block = None   # 契約違反で DONE を BLOCKED に読み替えた理由
        self.gate_failure = None   # gate 打ち切り時の {cmd, rc, tail, retries}
        self.limit_info = None     # 枠切れ検出時の {reason, until}
        resume_running(self.task_dir, "wait 開始")

    def tick(self):
        """観測 → decide()。戻り値は decide() のアクション (NUDGE/STALL_NOTIFY は処理済み)."""
        pane = observe_pane(self.pane_id)
        self.status = pane.get("agent_status") if pane else None
        # 一回限りの trust-dialog ワークアラウンド: claude の「このフォルダを信頼しますか」
        # ダイアログ表示中は nudge/stall ロジックが無力 (テキスト送信では進まない)。
        # 実測 (herdr 0.7.1) ではダイアログ中も agent_status は "idle" なので、status では
        # 判別せず毎回 pane の可視テキストを見る。一度 Return を送ったら再送しない。
        # このループは decide() を通さず status=None (次の待機は POLL_SECS の sleep) にする。
        if pane is not None and not self.trust_tried and maybe_trust_dialog(self.pane_id):
            self.trust_tried = True
            self.status = None
            return "CONTINUE"
        now = time.time()
        self.idle_since = (self.idle_since or now) if self.status == "idle" else None
        idle_secs = now - self.idle_since if self.idle_since else 0
        result_status = read_result_status(self.task_dir)
        action = decide(
            self.status, result_status, self.nudges, idle_secs,
            timed_out=bool(self.deadline and now > self.deadline),
            quiet_secs=self._quiet_secs(now), stall_secs=self.stall_secs,
            stall_grace=self.stall_grace, already_notified=self.notified,
            protocol_violation=os.path.exists(os.path.join(self.task_dir, "protocol_violation")),
            limited=self._limited(result_status))
        return self._apply(action)

    def _limited(self, result_status):
        """idle/blocked で result なしのとき pane 末尾に枠切れ表示があるか (検出内容は limit_info)."""
        if self.status not in ("idle", "blocked") or result_status is not None:
            return False
        self.limit_info = detect_limit(pane_tail(self.pane_id, LIMIT_TAIL_LINES), time.time())
        return self.limit_info is not None

    def _quiet_secs(self, now):
        if self.status != "working" or not self.stall_secs:
            self.progress.reset(now)
            return 0
        if self.progress.observe(progress_signature(self.manifest), now) and self.notified:
            self.notified = False
            update_manifest(self.task_dir, lambda m: m.update(stall_notified_at=None))
        return self.progress.quiet_secs(now)

    def _apply(self, action):
        if action == "NUDGE":
            nudge(self.pane_id, self.task_dir)
            self.nudges += 1
            self.idle_since = None
        elif action == "STALL_NOTIFY":
            self._notify_stall()
        elif action == "DONE":
            return self._done_gates()
        return action

    def _done_gates(self):
        """DONE 時の検査を順に: --schema → 契約の証跡 → --gate コマンド."""
        if self.manifest.get("schema") and self._schema_gate() != "DONE":
            return "CONTINUE"
        if self.manifest.get("contract") and not result_has_evidence(self.task_dir):
            self.forced_block = f"result に「{EVIDENCE_HEADING}」節が無い (verify の実行証跡を書くこと)"
            return "BLOCKED"
        return self._command_gates()

    def _command_gates(self):
        """--gate を cwd で実行。失敗は tail を worker に差し戻し、retries 超過で GATE_FAILED."""
        gates = self.manifest.get("gates") or []
        retries = self.manifest.get("gate_retries") or DEFAULT_GATE_RETRIES
        timeout = clamp_gate_timeout(self.manifest.get("gate_timeout") or DEFAULT_GATE_TIMEOUT,
                                     self.deadline, time.time())
        failure = first_gate_failure(gates, self.manifest["cwd"], timeout)
        if failure is None:
            return "DONE"
        cmd, rc, output = failure
        failures = bump_gate_failures(self.task_dir)
        append_event(self.task_dir, "gate", f"失敗 {failures}/{retries}: {cmd} rc={rc}")
        if gate_verdict(failures, retries) == "exhausted":
            self.gate_failure = {"cmd": cmd, "rc": rc, "tail": tail_bytes(output), "retries": retries}
            return "GATE_FAILED"
        resend(self.task_dir, self.pane_id, gate_feedback(cmd, rc, output, failures, retries))
        self.nudges, self.idle_since = 0, None
        return "CONTINUE"

    def _notify_stall(self):
        self.notified = True
        update_manifest(self.task_dir, lambda m: (
            m.update(stall_notified_at=now_iso()),
            add_event(m, "stall", f"進捗なし {self.stall_secs}s", now_iso())))
        notify(f"delegate {self.task_id} 進捗なし",
               f"working だが {self.stall_secs}s 進捗なし (あと {self.stall_grace}s で quiet 終了)")

    def _schema_gate(self):
        """DONE 時の --schema 検証。違反なら補正を1回送り、再違反は警告つきで done 扱い."""
        with open(os.path.join(self.task_dir, "schema.json")) as f:
            errors = schema_errors(self.task_dir, json.load(f))
        m = load_manifest(self.task_dir)
        try:
            mtime = os.path.getmtime(os.path.join(self.task_dir, "result.json"))
        except OSError:
            mtime = None
        act = schema_gate_action(errors, m.get("schema_corrected_at"), mtime, time.time())
        if act == "correct":
            send_line(self.pane_id, f"result.json がスキーマ違反: {'; '.join(errors)}。"
                      f"{self.task_dir}/result.json を修正して書き直すこと。")
            update_manifest(self.task_dir, lambda man: man.update(schema_corrected_at=time.time()))
            self.idle_since = None
            return "CONTINUE"
        if act == "wait":
            return "CONTINUE"
        update_manifest(self.task_dir, lambda man: man.update(
            schema_valid=act == "ok", schema_errors=errors))
        if act == "invalid_final":
            print(f"herdr-delegate: WARN schema 違反のまま完了: {'; '.join(errors)}",
                  file=sys.stderr)
        return "DONE"


def bump_gate_failures(task_dir):
    """gate 失敗の累計回数を台帳に加算して返す."""
    def mutate(m):
        m["gate_failures"] = m.get("gate_failures", 0) + 1
        return m["gate_failures"]
    return update_manifest(task_dir, mutate)


def wait_single(args, task_id):
    """1 task を待ち、JSON 1行を出して終了コードで exit する (従来の出力形式)."""
    d = task_dir_of(task_id)
    m = load_manifest(d)
    if effective_state(m) in TERMINAL_STATES:  # 終端済みは観測せず台帳から報告 (wait_many と同じ)
        out = ledger_result(task_id, m, d)
        print(json.dumps(out))
        sys.exit(out["exit_code"])
    w = Watcher(task_id, args)
    while True:
        action = w.tick()
        if action in OUTCOMES:
            out, code = record_outcome(w, action)
            print(json.dumps(out))
            sys.exit(code)
        wait_step(w.pane_id, w.status, w.deadline)


def ledger_result(task_id, m, d):
    """終端済み task は観測せず台帳の state から報告する."""
    state = effective_state(m)
    return {"task_id": task_id, "exit_code": STATE_EXIT.get(state, EXIT_FAILED),
            "status": PUBLIC_STATUS.get(state, state), "state": state,
            **result_summary(d, m)}


def wait_many(args, task_ids):
    """複数 task を単一プロセスで待ち、全 task (--any なら最初の1つ) の終端後に JSON サマリを出す."""
    results, watchers = {}, {}
    for tid in task_ids:
        d = task_dir_of(tid)
        m = load_manifest(d)
        if effective_state(m) in TERMINAL_STATES:
            results[tid] = ledger_result(tid, m, d)
    for tid in task_ids:
        if tid not in results and not (args.any and results):
            watchers[tid] = Watcher(tid, args)
    while watchers and not (args.any and results):
        for tid, w in list(watchers.items()):
            action = w.tick()
            if action not in OUTCOMES:
                continue
            out, code = record_outcome(w, action)
            results[tid] = {**out, "exit_code": code, **result_summary(w.task_dir, w.manifest)}
            del watchers[tid]
            if action == "BLOCKED":  # 即時に気付けるよう 1 行だけ先に出す
                print(json.dumps({"event": "blocked", **{k: out[k] for k in out if k != "status"}},
                                 ensure_ascii=False), file=sys.stderr)
        if watchers and not (args.any and results):
            time.sleep(POLL_SECS)
    ordered = [results[t] for t in task_ids if t in results]
    print(json.dumps({"results": ordered, "pending": list(watchers)}, ensure_ascii=False))
    sys.exit(first_nonzero_exit(ordered))


def first_nonzero_exit(results):
    """全 done なら 0、それ以外は最初の非 0 の終了コード."""
    return next((r["exit_code"] for r in results if r["exit_code"]), 0)


def group_task_ids(group):
    return [tid for tid, _, m in iter_manifests() if m.get("group") == group]


def cmd_wait(args):
    ids = list(dict.fromkeys(args.task_ids + (group_task_ids(args.group) if args.group else [])))
    if not ids:
        die("wait: task id か --group (該当 task あり) を指定すること", EXIT_CONFIG)
    if len(ids) == 1 and not args.group:
        wait_single(args, ids[0])
    else:
        wait_many(args, ids)


def result_text(task_dir):
    """collect で表示する本文。result.md 優先、無ければ result.json を整形 (どちらも無ければ None)."""
    text = _read_text(os.path.join(task_dir, "result.md"))
    if text is not None:
        return text
    res = load_result(task_dir)
    return json.dumps(res["raw"], ensure_ascii=False, indent=2) if res else None


def report_artifacts(task_dir, m):
    """artifacts を絶対パスで列挙し、存在しないパスは WARN と manifest(artifacts_missing) に残す."""
    res = load_result(task_dir)
    if not res or not res["artifacts"]:
        return
    resolved = resolve_artifacts(res["artifacts"], m.get("cwd") or task_dir)
    print("--- artifacts (絶対パス) ---")
    for a in resolved:
        print(a["path"] or a["raw"])
        if a["missing"]:
            print(f"herdr-delegate: WARN artifact が存在しない: {a['path']}", file=sys.stderr)
    missing = [a["path"] for a in resolved if a["missing"]]
    update_manifest(task_dir, lambda man: man.update(artifacts_missing=missing))


def cmd_collect(args):
    task_dir = task_dir_of(args.task_id)
    manifest = load_manifest(task_dir)
    text = result_text(task_dir)
    if text is not None:
        print(text)
        report_artifacts(task_dir, manifest)
        record_collected(task_dir)
        return
    append_event(task_dir, "collect", "result なし (pane 末尾で代替)")
    print("# result なし — pane 末尾で代替:", file=sys.stderr)
    print(pane_tail(manifest["pane_id"], 60))
    sys.exit(EXIT_STALLED)


def record_collected(task_dir):
    """collect で result を渡した事実と、result の status を台帳へ反映する."""
    status = read_result_status(task_dir)
    if status in RESULT_STATUSES:
        transition(task_dir, status, detail="collect", pane_alive=False)
        snapshot_post(task_dir)
        mark_delivered(task_dir)  # 未確定 (status 行なし) の result は配信済みにしない


ROUND_FILES = ("protocol_violation", "stop_nudges")
ROUND_MANIFEST_KEYS = ("schema_corrected_at", "schema_valid", "schema_errors", "stall_notified_at")


def reset_round_state(task_dir):
    """send による再投入で、前ラウンドの終了契約強制状態 (催促回数・違反印・補正履歴) を消す."""
    for name in ROUND_FILES:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(os.path.join(task_dir, name))

    def mutate(m):
        for k in ROUND_MANIFEST_KEYS:
            m.pop(k, None)
    update_manifest(task_dir, mutate)


def resend(task_dir, pane_id, text):
    """古い result を退避して text を worker に送り、running に戻す。送れなければ result を戻し False."""
    archived = archive_result(task_dir)  # 古い result を完了と誤読させない
    try:
        sent = send_line(pane_id, text)
    except BaseException:
        restore_result(task_dir, archived)  # herdr 側失敗でも result.md を戻す
        raise
    if not sent:
        restore_result(task_dir, archived)
        return False
    append_event(task_dir, "send", text[:200])
    reset_round_state(task_dir)
    transition(task_dir, "running", detail="send で再投入", force=True)
    return True


def cmd_send(args):
    task_dir = task_dir_of(args.task_id)
    manifest = load_manifest(task_dir)
    if observe_pane(manifest["pane_id"]) is None:
        die(f"send: pane が無い ({manifest['pane_id']})", EXIT_GONE)
    if not resend(task_dir, manifest["pane_id"], args.text):
        raise SystemExit("send: エコーバック検証に失敗 (2回試行)")
    # 人手の再投入は gate 試行回数をやり直す (gate 自動差し戻しの resend では保持する)
    update_manifest(task_dir, lambda m: m.pop("gate_failures", None))


def task_ids_newest_first():
    if not os.path.isdir(TASKS_DIR):
        return []
    return sorted(os.listdir(TASKS_DIR),
                  key=lambda t: os.path.getmtime(os.path.join(TASKS_DIR, t)),
                  reverse=True)


def iter_manifests(ids=None):
    for tid in ids if ids is not None else task_ids_newest_first():
        d = os.path.join(TASKS_DIR, tid)
        if os.path.isfile(os.path.join(d, "manifest.json")):
            yield tid, d, load_manifest(d)


