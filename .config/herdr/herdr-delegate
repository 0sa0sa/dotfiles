SAFE_GIT = ("-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false")
GIT_PROBE_ENV = {"GIT_TERMINAL_PROMPT": "0"}
ARCHIVE_REF = "refs/herdr/archive/{}"


def probe_worktree(path, base):
    """worktree の成果有無: {"commits": base..HEAD の件数, "dirty": porcelain 件数}。取れなければ None.

    base が無い旧 manifest は remote 未到達の commit 数で代用する (多めに数え archive 側に倒れる)。
    """
    revs = [f"{base}..HEAD"] if base else ["HEAD", "--not", "--remotes"]
    count = run_git(path, *SAFE_GIT, "rev-list", "--count", *revs, env=GIT_PROBE_ENV)
    status = run_git(path, *SAFE_GIT, "status", "--porcelain", env=GIT_PROBE_ENV)
    return {"commits": int(count) if count and count.isdigit() else None,
            "dirty": None if status is None else count_porcelain(status)}


def plan_worktree_removal(probe, force_discard):
    """worktree 削除の方針 (純関数).

    remove(成果なし) / archive_remove(退避 ref を作ってから削除) /
    refuse_dirty(未コミットあり + --force-discard なし) / inspection_failed(削除しない).
    """
    if probe["commits"] is None or probe["dirty"] is None:
        return "inspection_failed"
    if probe["dirty"] and not force_discard:
        return "refuse_dirty"
    return "archive_remove" if probe["commits"] or probe["dirty"] else "remove"


def snapshot_dirty(path, head):
    """未コミット (untracked 含む) を一時 index でコミット化し sha を返す。失敗は None."""
    ident = ("-c", "user.name=herdr-delegate", "-c", "user.email=herdr-delegate@localhost")
    with tempfile.TemporaryDirectory() as tmp:
        env = {**GIT_PROBE_ENV, "GIT_INDEX_FILE": os.path.join(tmp, "index")}
        if run_git(path, "read-tree", head, env=env) is None:
            return None
        if run_git(path, "add", "-A", env=env, timeout=60) is None:
            return None
        tree = run_git(path, "write-tree", env=env)
        return tree and run_git(path, *ident, "commit-tree", tree, "-p", head,
                                "-m", "herdr-delegate: dirty snapshot", env=env)


def archive_worktree(path, task_id, probe):
    """HEAD と (dirty なら) 作業ツリーの snapshot を refs/herdr/archive/<id>[-dirty] に残す.

    成功なら作った ref 名のリスト、失敗は None (削除してはいけない)。
    """
    head = run_git(path, "rev-parse", "HEAD")
    ref = ARCHIVE_REF.format(task_id)
    if not head or run_git(path, "update-ref", ref, head) is None:
        return None
    refs = [ref]
    if probe["dirty"]:
        snap = snapshot_dirty(path, head)
        if not snap or run_git(path, "update-ref", ref + "-dirty", snap) is None:
            return None
        refs.append(ref + "-dirty")
    return refs


