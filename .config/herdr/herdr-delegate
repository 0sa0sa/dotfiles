# ---------- limit detection / CLI health ----------

LIMIT_TAIL_LINES = 20
LIMIT_FALLBACK_SECS = 1800  # reset 時刻を読めない枠切れの仮の退避時間
AUTO_AGENTS = ("claude", "codex")  # --agent auto の優先順 (先頭が既定)
# 枠切れ表示の検出パターン。誤検知を避けるため過去形・到達形に限る保守的な設定。
# 注意: 実機の枠切れ画面の文言は未採取。下記は想定文言で、実機で差異が出たらここを直す。
LIMIT_RES = tuple(re.compile(p, re.IGNORECASE) for p in (
    r"you'?ve hit your\b.*\blimit",
    r"\b(usage|rate|session|weekly|daily|5-hour) limit (has been )?(reached|exceeded|hit)\b",
    r"\blimit reached\b",
))
LIMIT_WORD_RE = re.compile(r"\b(usage|rate) limit\b", re.IGNORECASE)
RESET_HINT_RE = re.compile(r"\bresets?\b", re.IGNORECASE)
RESET_AT_RE = re.compile(r"\bresets?\s+(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*([ap]m)?", re.IGNORECASE)
RESET_IN_RE = re.compile(r"\bresets?\s+in\s+(\d+)\s*(h|hour|m|min)", re.IGNORECASE)


def parse_reset_epoch(text, now):
    """枠切れ表示の復帰時刻 (epoch)。"resets at 3pm" / "resets at 15:30" (ローカル時刻) と
    "resets in 2 hours" を解釈する。読めなければ None (曖昧な "resets at 3" も None)."""
    m = RESET_IN_RE.search(text)
    if m:
        return now + int(m.group(1)) * (3600 if m.group(2).lower().startswith("h") else 60)
    m = RESET_AT_RE.search(text)
    if not m or not (m.group(2) or m.group(3)):
        return None
    hour, minute, ampm = int(m.group(1)), int(m.group(2) or 0), (m.group(3) or "").lower()
    if ampm:
        if not 1 <= hour <= 12:
            return None
        hour = hour % 12 + (12 if ampm == "pm" else 0)
    if hour > 23 or minute > 59:
        return None
    at = datetime.datetime.fromtimestamp(now).replace(hour=hour, minute=minute,
                                                      second=0, microsecond=0)
    if at.timestamp() <= now:
        at += datetime.timedelta(days=1)
    return at.timestamp()


def detect_limit(tail, now):
    """pane 末尾 (最後の LIMIT_TAIL_LINES 行) から枠切れを検出する純関数.

    戻り値: {"reason": 該当行, "until": 復帰 epoch または None} / 枠切れでなければ None。
    """
    lines = tail.splitlines()[-LIMIT_TAIL_LINES:]
    hit = next((ln for ln in lines if any(r.search(ln) for r in LIMIT_RES)), None)
    if hit is None and RESET_HINT_RE.search("\n".join(lines)):
        hit = next((ln for ln in lines if LIMIT_WORD_RE.search(ln)), None)
    if hit is None:
        return None
    return {"reason": hit.strip()[:200], "until": parse_reset_epoch("\n".join(lines), now)}


def active_limits(health, now):
    """health.json の内容から期限内の {cli: {until, reason}} だけを返す (期限切れは自動復帰)."""
    return {cli: e for cli, e in health.items()
            if isinstance(e, dict) and e.get("until", 0) > now}


def with_limit(health, cli, info, now):
    """cli を枠切れとして記録した新しい health (until 不明は LIMIT_FALLBACK_SECS 後)."""
    return {**active_limits(health, now),
            cli: {"until": info["until"] or now + LIMIT_FALLBACK_SECS, "reason": info["reason"]}}


def pick_agent(requested, health, now, order=AUTO_AGENTS, available=lambda cli: True):
    """--agent の解決: (agent, fallback_from)。auto は枠切れでない最初の CLI (claude 既定).

    候補が無ければ (None, None)。fallback_from は既定 CLI を避けたときだけその名前。
    """
    if requested != "auto":
        return requested, None
    limited = active_limits(health, now)
    for cli in order:
        if cli not in limited and available(cli):
            return cli, (order[0] if cli != order[0] else None)
    return None, None


def health_path():
    return os.path.join(os.path.dirname(TASKS_DIR), "health.json")


def load_health():
    try:
        with open(health_path()) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def save_health(health):
    os.makedirs(os.path.dirname(health_path()), exist_ok=True)
    atomic_write_json(health_path(), health)


def resolve_agent(requested):
    """spawn の --agent を解決する。auto で全 CLI が枠切れなら ConfigError."""
    agent, fallback_from = pick_agent(requested, load_health(), time.time(),
                                      available=lambda cli: bool(shutil.which(cli)))
    if agent is None:
        raise ConfigError("--agent auto: 使える CLI が無い (全て枠切れか未インストール。"
                          "herdr-delegate health で確認)")
    return agent, fallback_from


# ---------- ledger state machine ----------
# state: running|done|failed|blocked|stalled|quiet|timeout|limited|gone|killed|protocol_violation
# 終端 (不変): 作業の決着がついたもの。set_state(force=True) 以外では上書きしない。
# 再開可能 (blocked/stalled/quiet/timeout/limited): worker が生きていて回復し得る。
# running へ戻れる (resume) のは再開可能 state と、send による done/failed の再投入のみ。
TERMINAL_STATES = frozenset({"done", "failed", "gone", "killed", "protocol_violation"})
NO_REOPEN_STATES = frozenset({"gone", "killed"})  # pane が無いので force でも戻さない


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def effective_state(m):
    """manifest の state。state キーの無い旧 manifest は killed_at から導く."""
    return m.get("state") or ("killed" if m.get("killed_at") else "running")


def apply_state(m, state, now, detail=None, exit_reason=None, force=False):
    """manifest dict を state 遷移させる純関数。変化したら True."""
    cur = effective_state(m)
    if cur == state:
        return False
    if cur in NO_REOPEN_STATES or (cur in TERMINAL_STATES and not force):
        return False
    m["state"] = state
    m.setdefault("events", []).append(
        {"ts": now, "kind": "state", "state": state, "detail": detail})
    if state == "running":  # resume: 前回の決着情報を消す
        m["finished_at"] = m["exit_reason"] = m["delivered_at"] = None
    else:
        m["finished_at"] = now
        m["exit_reason"] = exit_reason or state
    return True


def add_event(m, kind, detail, now):
    m.setdefault("events", []).append({"ts": now, "kind": kind, "detail": detail})


def needs_verification(m):
    """done の確定に Watcher の検査 (schema/証跡/--gate) が要る task か。旧 manifest は不要扱い."""
    return bool(m.get("gates") or m.get("schema") or m.get("contract"))


def reconcile_state(state, result_status, pane, needs_gate=False):
    """reconcile 用: 現 state と観測から新 state を返す (変化なしは None)。

    result.md が failed、または done で検査不要 (needs_gate=False) かつ worker が
    working でなければそれを採用。検査が要る done は Watcher の仕事なので採用しない。
    pane が消えていて結果が確定していなければ gone。
    """
    if state in TERMINAL_STATES:
        return None
    pane_working = bool(pane) and pane.get("agent_status") == "working"
    adoptable = result_status == "failed" or (result_status == "done" and not needs_gate)
    if adoptable and not pane_working:
        return result_status
    if pane is None:
        return "gone"
    return None


def format_reinject(rows, max_rows=10, max_line=200):
    """status --active --format reinject 用の再注入テキスト (空なら "")."""
    if not rows:
        return ""
    out = ["[Active delegated workers preserved across context compaction. "
           "REFERENCE ONLY: 状態は wait/status で再確認すること。"
           "done/failed/killed は含まない]"]
    for r in rows[:max_rows]:
        parts = [f"- {r['task_id']} {r['agent']} pane={r['pane_id']} state={r['state']}",
                 f"cwd={r['cwd']}"]
        if r.get("branch"):
            parts.append(f"branch={r['branch']}")
        parts.append(f"result.md={r['result_path']}")
        line = " ".join(parts)
        out.append(line if len(line) <= max_line else line[:max_line - 1] + "…")
    if len(rows) > max_rows:
        out.append(f"- …他 {len(rows) - max_rows} 件")
    return "\n".join(out)


def count_porcelain(text):
    return len([ln for ln in (text or "").splitlines() if ln.strip()])


IDEM_TTL_SECS = 24 * 3600


def idem_dir():
    return os.path.join(os.path.dirname(TASKS_DIR), "idem")


def idem_path(key):
    return os.path.join(idem_dir(), hashlib.sha256(key.encode()).hexdigest() + ".json")


def prompt_sha(prompt_body):
    return hashlib.sha256(prompt_body.encode()).hexdigest()


def idem_verdict(record, sha):
    """既存 idem レコードと今回 prompt の突き合わせ: existing|in_progress|conflict."""
    if record.get("prompt_sha256") != sha:
        return "conflict"
    return "existing" if record.get("task_id") else "in_progress"


def preflight_problems(agent, cwd, worktree=False, which=shutil.which, isdir=os.path.isdir,
                       herdr_ok=None, is_git=None):
    """spawn 前の環境チェック。問題の説明リスト (空なら OK).

    herdr_ok/is_git は到達性・git 判定の注入口 (既定は実 herdr / 実 git)。
    """
    problems = []
    for exe in ("herdr", agent):
        if not which(exe):
            problems.append(f"{exe} が PATH に無い")
    if not isdir(cwd):
        problems.append(f"cwd が存在しない: {cwd}")
        return problems
    if which("herdr") and not (herdr_ok or herdr_reachable)():
        problems.append("herdr サーバに到達できない (herdr が起動していない?)")
    if worktree and not (is_git or is_git_repo)(cwd):
        problems.append(f"--worktree には git リポジトリが必要: {cwd}")
    return problems


# ---------- manifest I/O (atomic + lock) ----------

def atomic_write_json(path, data):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def save_manifest(task_dir, data):
    atomic_write_json(os.path.join(task_dir, "manifest.json"), data)


def load_manifest(task_dir):
    with open(os.path.join(task_dir, "manifest.json")) as f:
        return json.load(f)


@contextlib.contextmanager
def manifest_lock(task_dir):
    """複数 orchestrator の read-modify-write 競合を避ける簡易 flock."""
    with open(os.path.join(task_dir, ".lock"), "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        yield


def update_manifest(task_dir, mutate):
    """ロック下で manifest を読み、mutate(m) の戻り値を返しつつ保存する."""
    with manifest_lock(task_dir):
        m = load_manifest(task_dir)
        result = mutate(m)
        save_manifest(task_dir, m)
        return result


PANE_SOURCE = "herdr-delegate"
NO_PANE_REPORT_STATES = frozenset({"gone", "killed"})  # pane が無い/閉じる


def metadata_args(pane_id, state, title=None):
    """herdr pane report-metadata の引数 (UI のペイン枠に task state を出す)."""
    args = ["pane", "report-metadata", pane_id, "--source", PANE_SOURCE,
            "--custom-status", state]
    return args + ["--title", title] if title else args


def report_pane_state(pane_id, state, title=None):
    """pane の custom-status/title に task state を反映する。表示だけなので失敗は無視."""
    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
        subprocess.run(["herdr", *metadata_args(pane_id, state, title)],
                       capture_output=True, timeout=HCLI_TIMEOUT_SECS)


def set_state(task_dir, state, detail=None, exit_reason=None, force=False):
    shown = {}

    def mutate(m):
        shown.update(pane=m.get("pane_id"), title=m.get("label") or m.get("task_id"))
        return apply_state(m, state, now_iso(), detail, exit_reason, force)
    changed = update_manifest(task_dir, mutate)
    if changed and shown["pane"] and state not in NO_PANE_REPORT_STATES:
        report_pane_state(shown["pane"], state, shown["title"])
    return changed


def append_event(task_dir, kind, detail):
    update_manifest(task_dir, lambda m: add_event(m, kind, detail, now_iso()))


def mark_delivered(task_dir):
    def mutate(m):
        m["delivered_at"] = m.get("delivered_at") or now_iso()
    update_manifest(task_dir, mutate)


def transition(task_dir, state, detail=None, pane_alive=False, force=False, exit_reason=None):
    """state 遷移を記録し、pane が生きていれば recovery.json も保存する."""
    changed = set_state(task_dir, state, detail, exit_reason, force=force)
    if changed and pane_alive:
        save_recovery(task_dir, state)
    return changed


def resume_running(task_dir, detail):
    """再開可能 state の task を running に戻す (既に running/終端なら何もしない)."""
    m = load_manifest(task_dir)
    if effective_state(m) not in TERMINAL_STATES:
        set_state(task_dir, "running", detail)


def gc_idem(now=None):
    """24h 超の idem レコードを削除する."""
    now = now or time.time()
    try:
        names = os.listdir(idem_dir())
    except OSError:
        return
    for name in names:
        p = os.path.join(idem_dir(), name)
        try:
            if now - os.path.getmtime(p) > IDEM_TTL_SECS:
                os.unlink(p)
        except OSError:
            pass


def claim_idem(key, sha, agent):
    """idem キーを確保。("new", path) か ("existing"|"in_progress"|"conflict", record).

    レコードは一時ファイルに書いてから os.link で原子的に配置する
    (空/書きかけファイルを他 spawn に読ませない)。壊れた旧レコードは in_progress 扱い。
    """
    os.makedirs(idem_dir(), exist_ok=True)
    path = idem_path(key)
    tmp = f"{path}.{os.getpid()}.tmp"
    atomic_write_json(tmp, {"prompt_sha256": sha, "agent": agent,
                            "created_at": now_iso(), "task_id": None})
    try:
        os.link(tmp, path)
    except FileExistsError:
        return _read_idem(path, sha)
    finally:
        release_idem(tmp)
    return "new", path


def _read_idem(path, sha):
    try:
        with open(path) as f:
            record = json.load(f)
    except (OSError, ValueError):
        return "in_progress", {}  # 空・壊れたレコード
    return idem_verdict(record, sha), record


def finish_idem(path, task_id):
    with open(path) as f:
        record = json.load(f)
    record["task_id"] = task_id
    atomic_write_json(path, record)


def release_idem(path):
    with contextlib.suppress(OSError):
        os.unlink(path)


# ---------- herdr I/O ----------

CALL_TIMEOUT_SECS = 10
HCLI_TIMEOUT_SECS = 30


class ConfigError(Exception):
    """preflight / 設定エラー (終了コード EXIT_CONFIG)."""


class HerdrUnavailable(RuntimeError):
    """herdr ソケット/CLI に到達できない (pane 消失とは区別する)."""


def call(method, params):
    req = json.dumps({"id": f"delegate:{method}", "method": method, "params": params}) + "\n"
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(CALL_TIMEOUT_SECS)
            s.connect(SOCK)
            s.sendall(req.encode())
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
    except OSError as e:  # timeout / 接続拒否 / ソケット無し
        raise HerdrUnavailable(f"{method}: herdr ソケット {SOCK} に到達できない ({e})") from e
    try:
        resp = json.loads(buf)
    except ValueError as e:
        raise RuntimeError(f"{method}: 不正な応答 {buf[:200]!r}") from e
    if "error" in resp:
        raise RuntimeError(f"{method}: {resp['error']}")
    return resp["result"]


def hcli(*args):
    try:
        proc = subprocess.run(["herdr", *args], capture_output=True, text=True,
                              timeout=HCLI_TIMEOUT_SECS)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise HerdrUnavailable(f"herdr {' '.join(args)}: 実行できない ({e})") from e
    if proc.returncode != 0:
        raise RuntimeError(f"herdr {' '.join(args)}: {proc.stderr.strip()}")
    out = proc.stdout.strip()
    if not out:
        return {}
    try:
        return json.loads(out).get("result", {})
    except ValueError as e:
        raise RuntimeError(f"herdr {' '.join(args)}: JSON 以外の出力 {out[:200]!r}") from e


def get_pane(pane_id):
    """pane 情報。pane が無ければ None、herdr 到達不能なら HerdrUnavailable."""
    try:
        return call("pane.get", {"pane_id": pane_id})["pane"]
    except HerdrUnavailable:
        raise
    except RuntimeError:
        return None


def current_workspace_id():
    ws = os.environ.get("HERDR_WORKSPACE_ID")
    if ws:
        return ws
    return hcli("pane", "current")["pane"]["workspace_id"]


# ---------- git probes ----------

GIT_TIMEOUT_SECS = 5


def run_git(cwd, *args, env=None, timeout=GIT_TIMEOUT_SECS):
    """git -C cwd args の stdout (失敗/タイムアウト/非 repo は None)."""
    try:
        proc = subprocess.run(
            ["git", "-C", cwd, *args], capture_output=True, text=True,
            stdin=subprocess.DEVNULL, timeout=timeout,
            env={**os.environ, "GIT_OPTIONAL_LOCKS": "0", **(env or {})})
    except (OSError, subprocess.TimeoutExpired):
        return None
    return proc.stdout.strip() if proc.returncode == 0 else None


def git_snapshot(cwd):
    status = run_git(cwd, "status", "--porcelain")
    return {
        "branch": run_git(cwd, "rev-parse", "--abbrev-ref", "HEAD"),
        "head": run_git(cwd, "rev-parse", "HEAD"),
        "dirty": None if status is None else count_porcelain(status),
    }


def is_git_repo(cwd):
    return run_git(cwd, "rev-parse", "--is-inside-work-tree") == "true"


def herdr_reachable():
    try:
        hcli("workspace", "list")
    except (HerdrUnavailable, RuntimeError):
        return False
    return True


# ---------- progress detection (stall) ----------

def claude_project_slug(cwd):
    """claude の ~/.claude/projects/<slug> 名。英数字以外はすべて "-" (実測: / . _ など)."""
    return re.sub(r"[^a-zA-Z0-9]", "-", cwd)


def epoch_iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(epoch))


def iso_to_epoch(text):
    """manifest の created_at (%Y-%m-%dT%H:%M:%S%z) → epoch。解釈不能は 0."""
    try:
        return datetime.datetime.strptime(text, "%Y-%m-%dT%H:%M:%S%z").timestamp()
    except (TypeError, ValueError):
        return 0.0


def newest_file(paths, since=0.0):
    """mtime が since 以降で最新のファイルの (path, mtime_ns, size)。無ければ None."""
    best = None
    for p in paths:
        try:
            st = os.stat(p)
        except OSError:
            continue
        if st.st_mtime >= since and (best is None or st.st_mtime_ns > best[1]):
            best = (p, st.st_mtime_ns, st.st_size)
    return best


def claude_transcript(cwd, since, home):
    slugs = {claude_project_slug(cwd), claude_project_slug(os.path.realpath(cwd))}
    paths = [p for sl in slugs
             for p in glob.glob(os.path.join(home, ".claude", "projects", sl, "*.jsonl"))]
    return newest_file(paths, since)


def codex_session_cwd(path):
    """rollout jsonl 先頭行 (session_meta) の cwd。読めなければ None."""
    try:
        with open(path) as f:
            return json.loads(f.readline()).get("payload", {}).get("cwd")
    except (OSError, ValueError, AttributeError):
        return None


def codex_day_dirs(since, today, home):
    """spawn 日〜今日の ~/.codex/sessions/YYYY/MM/DD (ローカル日付) を列挙する."""
    day = datetime.date.fromtimestamp(since)
    last = datetime.date.fromtimestamp(today)
    dirs = []
    while day <= last:
        dirs.append(os.path.join(home, ".codex", "sessions", f"{day:%Y/%m/%d}"))
        day += datetime.timedelta(days=1)
    return dirs


def codex_transcript(cwd, since, home, now=None):
    candidates = []
    for d in codex_day_dirs(since, now or time.time(), home):
        for p in glob.glob(os.path.join(d, "rollout-*.jsonl")):
            found = newest_file([p], since)
            if found:
                candidates.append(found)
    wanted = {cwd, os.path.realpath(cwd)}
    for found in sorted(candidates, key=lambda f: -f[1]):
        if codex_session_cwd(found[0]) in wanted:
            return found
    return None


def progress_signature(m, home=None):
    """worker の進捗シグネチャ文字列。transcript の mtime+size、無ければ git status の hash.

    観測不能 (transcript も git も取れない) は None。
    """
    home = home or os.path.expanduser("~")
    since = iso_to_epoch(m.get("created_at"))
    finder = codex_transcript if m.get("agent") == "codex" else claude_transcript
    found = finder(m["cwd"], since, home)
    if found:
        return f"transcript:{found[0]}:{found[1]}:{found[2]}"
    status = run_git(m["cwd"], "status", "--porcelain")
    return None if status is None else "git:" + hashlib.sha256(status.encode()).hexdigest()


class ProgressWatch:
    """進捗シグネチャの変化から「進捗なし秒数」を数える。観測失敗 (None) は状態を変えない."""

    def __init__(self, now):
        self.sig, self.last = None, now

    def observe(self, sig, now):
        """シグネチャを記録し、進捗があった (前回と異なる) なら True."""
        if sig is None:
            return False
        progressed = self.sig is not None and sig != self.sig
        self.sig = sig
        if progressed:
            self.last = now
        return progressed

    def quiet_secs(self, now):
        return now - self.last

    def reset(self, now):
        self.sig, self.last = None, now


