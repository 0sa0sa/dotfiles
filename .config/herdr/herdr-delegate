                    help="worktree も外す。成果(commit/dirty)は refs/herdr/archive/<id> に退避")
    kl.add_argument("--force-discard", action="store_true",
                    help="未コミット変更があっても (退避 ref を作って) worktree を外す")
    kl.add_argument("--keep-snapshot", action="store_true",
                    help="作業前後の snapshot ref (refs/herdr-delegate/<id>) を GC せず残す")
    kl.set_defaults(func=cmd_kill)

    hl = sub.add_parser("health", help="枠切れ中の CLI を一覧 (期限切れは自動復帰)")
    hl.add_argument("cli", nargs="?", help="--reset の対象 CLI (省略で全て)")
    hl.add_argument("--reset", action="store_true", help="枠切れ記録を解除")
    hl.set_defaults(func=cmd_health)

    df = sub.add_parser("diff", help="非 worktree task の作業前後の差分 (spawn 時 snapshot との比較)")
    df.add_argument("task_id")
    df.add_argument("--stat", action="store_true")
    df.set_defaults(func=cmd_diff)

    rs = sub.add_parser("restore", help="worker が変更したファイルを spawn 前の状態に戻す")
    rs.add_argument("task_id")
    rs.add_argument("--file", action="append", default=[], metavar="F",
                    help="このファイルだけ戻す (複数可。cwd 相対)")
    rs.set_defaults(func=cmd_restore)

    rc = sub.add_parser("reconcile", aliases=["pending"],
                        help="台帳と pane 一覧を突き合わせ、未回収の結果を列挙")
    rc.add_argument("--mark-delivered", action="store_true")
    rc.add_argument("--json", action="store_true")
    rc.set_defaults(func=cmd_reconcile)

    dc = sub.add_parser("doctor", help="crashed/overtime/stranded/孤立 worktree などを診断 (exit 1: 所見あり)")
    dc.add_argument("--json", action="store_true")
    dc.add_argument("--reap", action="store_true", help="完了済みで pane が残っている task の pane を close")
    dc.add_argument("--max-runtime", type=int, default=DOCTOR_MAX_RUNTIME_SECS, metavar="SECS")
    dc.add_argument("--stranded-secs", type=int, default=DOCTOR_STRANDED_SECS)
    dc.add_argument("--reap-after", type=int, default=DOCTOR_REAP_AFTER_SECS)
    dc.add_argument("--cwd", help="孤立 worktree 検査に含める repo (既定: カレント)")
    dc.set_defaults(func=cmd_doctor)

    args = p.parse_args()
    try:
        args.func(args)
    except (ConfigError, HerdrUnavailable) as e:
        die(e, EXIT_CONFIG)


if __name__ == "__main__":
    main()
