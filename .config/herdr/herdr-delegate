def parse_name_status_z(text):
    """git diff --name-status -z --no-renames の出力 → [(status, path)]."""
    tokens = [t for t in text.split("\0") if t]
    return list(zip(tokens[0::2], tokens[1::2]))


def plan_restore(changes, only=None):
    """worker の変更 [(status, path)] から復元計画を作る純関数.

    restore: pre の内容に戻す (変更/削除されたもの) / remove: worker が新規作成したので消す /
    unknown: only に挙がったが worker が触れていないパス。only=None は全変更が対象。
    """
    picked = [(s, p) for s, p in changes if only is None or p in only]
    return {"restore": [p for s, p in picked if s[0] != "A"],
            "remove": [p for s, p in picked if s[0] == "A"],
            "unknown": sorted(set(only or ()) - {p for _, p in changes})}


def repo_relative(root, cwd, path):
    """cwd 基準の path を repo ルート相対にする (symlink は解決して比較)."""
    return os.path.relpath(os.path.realpath(os.path.join(cwd, path)), os.path.realpath(root))


def take_snapshot(cwd, task_id, name):
    """作業ツリー (untracked 含む) を refs/herdr-delegate/<id>/<name> に保存し sha を返す。失敗は None."""
    head = run_git(cwd, "rev-parse", "HEAD")
    sha = head and snapshot_dirty(cwd, head)
    ref = SNAP_REF.format(task_id, name)
    return sha if sha and run_git(cwd, "update-ref", ref, sha) is not None else None


def snapshot_sha(cwd, task_id, name):
    return run_git(cwd, "rev-parse", "--verify", "-q", SNAP_REF.format(task_id, name))


def delete_snapshot_refs(cwd, task_id):
    """task の snapshot ref (pre/post/pre-restore) を全て削除する."""
    refs = run_git(cwd, "for-each-ref", "--format=%(refname)", SNAP_PREFIX.format(task_id))
    for ref in (refs or "").splitlines():
        run_git(cwd, "update-ref", "-d", ref)


def snapshot_pre(args, pane, task_id):
    """spawn 前の snapshot。非 worktree かつ git repo のときだけ取り、sha (取れなければ None)."""
    if args.worktree is not None or not is_git_repo(pane["cwd"]):
        return None
    return take_snapshot(pane["cwd"], task_id, "pre")


def snapshot_post(task_dir):
    """終端時の snapshot (pre がある task のみ。失敗は握りつぶす)."""
    m = load_manifest(task_dir)
    if m.get("snapshot_pre"):
        take_snapshot(m["cwd"], m["task_id"], "post")


def post_state(m):
    """worker 作業後の状態 sha: 保存済み post ref、無ければ現在の作業ツリー."""
    return snapshot_sha(m["cwd"], m["task_id"], "post") or snapshot_dirty(
        m["cwd"], run_git(m["cwd"], "rev-parse", "HEAD"))


def snapshot_context(args):
    """diff/restore の共通前提: (task_dir, manifest, repo root, pre sha, post sha). 不備は ConfigError."""
    task_dir = task_dir_of(args.task_id)
    m = load_manifest(task_dir)
    pre = m.get("snapshot_pre") and snapshot_sha(m["cwd"], m["task_id"], "pre")
    if not pre:
        raise ConfigError("snapshot が無い task (worktree spawn / 非 git / kill 済みで GC 済み)")
    post = post_state(m)
    if not post:
        raise ConfigError("現在の作業ツリーの snapshot を取れない")
    return task_dir, m, run_git(m["cwd"], "rev-parse", "--show-toplevel"), pre, post


def cmd_diff(args):
    _, _, root, pre, post = snapshot_context(args)
    out = run_git(root, "diff", "--no-renames", *(["--stat"] if args.stat else []), pre, post,
                  timeout=60)
    if out is None:
        die("diff に失敗", EXIT_FAILED)
    print(out)


def cmd_restore(args):
    task_dir, m, root, pre, post = snapshot_context(args)
    if effective_state(m) == "running":
        die("running 中の task は restore できない (wait で終端させるか kill してから)", EXIT_FAILED)
    names = run_git(root, "diff", "--name-status", "-z", "--no-renames", pre, post, timeout=60)
    only = [repo_relative(root, m["cwd"], f) for f in args.file] or None
    if names is None:
        die("diff に失敗", EXIT_FAILED)
    plan = plan_restore(parse_name_status_z(names), only)
    if plan["unknown"]:
        die(f"worker が変更していないパス: {', '.join(plan['unknown'])}", EXIT_FAILED)
    backup = take_snapshot(m["cwd"], m["task_id"], "pre-restore")
    if not backup:
        die("復元前の snapshot (pre-restore) を取れないため中止", EXIT_FAILED)
    if plan["restore"] and run_git(root, "--literal-pathspecs", "restore", "--source", pre,
                                   "--worktree", "--", *plan["restore"], timeout=60) is None:
        die("git restore に失敗", EXIT_FAILED)
    for path in plan["remove"]:
        with contextlib.suppress(FileNotFoundError):
            os.remove(os.path.join(root, path))
    append_event(task_dir, "restore", f"restore={len(plan['restore'])} remove={len(plan['remove'])}")
    print(json.dumps({"restored": plan["restore"], "removed": plan["remove"],
                      "pre_restore": backup}, ensure_ascii=False))


def git_repo_root(path):
    """path (worktree 可) が属する本体 repo の作業ツリーのルート。特定できなければ None."""
    common = run_git(path, "rev-parse", "--git-common-dir")
    return os.path.dirname(os.path.normpath(os.path.join(path, common))) if common else None


def remove_worktree_via_git(path):
    """herdr の workspace が既に無い worktree を git で直接外す."""
    repo = git_repo_root(path)
    if not repo:
        raise RuntimeError(f"git worktree remove: {path} の repo を特定できない")
    if run_git(repo, "worktree", "remove", "--force", path) is None:
        raise RuntimeError(f"git worktree remove --force {path} に失敗")


def inspect_worktree(m, force_discard):
    """--rm-worktree の事前検査: (plan, probe)。worktree が既に無ければ plan=gone."""
    path = m["worktree_path"]
    if not os.path.isdir(path):
        return "gone", None
    probe = probe_worktree(path, m.get("base_commit"))
    return plan_worktree_removal(probe, force_discard), probe


def cmd_kill(args):
    task_dir = task_dir_of(args.task_id)
    m = load_manifest(task_dir)
    plan = probe = None
    if args.rm_worktree and m.get("worktree_path"):
        plan, probe = inspect_worktree(m, args.force_discard)
        if plan == "refuse_dirty":
            die(f"worktree に未コミット変更 {probe['dirty']} 件。破棄するなら --force-discard "
                f"(refs/herdr/archive に退避してから削除)", EXIT_FAILED)
    pane = get_pane(m["pane_id"])
    if pane:
        save_recovery(task_dir, "killed")  # pane を閉じる前に保存
    refs = None
    if plan == "archive_remove":
        refs = archive_worktree(m["worktree_path"], m["task_id"], probe)
        plan = "remove" if refs else "inspection_failed"
    removed = plan in ("remove", "gone") and remove_task_worktree(m, pane, plan)
    if not removed and pane:
        hcli("pane", "close", m["pane_id"])

    def mutate(man):
        now = now_iso()
        # killed_at より先に遷移させる (effective_state は killed_at からも killed を導くため)
        apply_state(man, "killed", now, detail="kill", exit_reason="killed")
        man["killed_at"] = now
        man["delivered_at"] = man.get("delivered_at") or now  # kill は orchestrator 自身の操作
        if removed:
            man["worktree_removed_at"] = now
        if refs:
            man["archive_refs"] = refs
        if plan == "inspection_failed":
            man["inspection_failed"] = True
    update_manifest(task_dir, mutate)
    release_snapshots(args, m)
    if plan == "inspection_failed":
        die(f"worktree の検査/退避に失敗したため削除しなかった: {m['worktree_path']}", EXIT_FAILED)


def release_snapshots(args, m):
    """kill 時の snapshot: 既定は ref を GC、--keep-snapshot なら最終状態を post に残す."""
    if not m.get("snapshot_pre"):
        return
    if args.keep_snapshot:
        take_snapshot(m["cwd"], m["task_id"], "post")
    else:
        delete_snapshot_refs(m["cwd"], m["task_id"])


def remove_task_worktree(m, pane, plan):
    """worktree を外す。実際に外した (herdr/git の削除を呼んだ) なら True.

    実測 (2026-07-10, smoke test): herdr worktree remove は workspace 全体 (pane 込み)
    を畳む。先に pane close すると workspace ごと消え、後続の remove が
    workspace_not_found で失敗するため、pane が生きていれば pane close は呼ばない。
    pane/workspace が既に無く worktree が残っていれば git で直接外す。
    """
    if pane:
        hcli("worktree", "remove", "--workspace", m["workspace_id"], "--force")
        return True
    if plan == "gone":
        return False  # 既に無い
    remove_worktree_via_git(m["worktree_path"])
    return True


def reconcile_all(panes_by_id):
    """全 task を観測と突き合わせて state を更新し、更新した (task_id, state) を返す."""
    changed = []
    for tid, d, m in iter_manifests():
        if m.get("pane_id") is None:  # spawn 途中の仮 manifest (diagnose_task と同じ除外)
            continue
        new = reconcile_state(effective_state(m), read_result_status(d),
                              panes_by_id.get(m["pane_id"]), needs_verification(m))
        if new and set_state(d, new, detail="reconcile"):
            changed.append({"task_id": tid, "state": new})
    return changed


def undelivered_rows():
    """running 以外で未回収 (delivered_at が null) の task。キー自体が無い旧 manifest は対象外."""
    return [{"task_id": tid, "state": effective_state(m), "agent": m["agent"],
             "exit_reason": m.get("exit_reason"), "finished_at": m.get("finished_at"),
             "result": os.path.join(d, "result.md"), "label": m.get("label")}
            for tid, d, m in iter_manifests()
            if effective_state(m) != "running" and "delivered_at" in m and not m["delivered_at"]]


def cmd_reconcile(args):
    panes = hcli("pane", "list").get("panes", [])
    changed = reconcile_all({p["pane_id"]: p for p in panes})
    rows = undelivered_rows()
    if args.mark_delivered:
        for r in rows:
            mark_delivered(os.path.dirname(r["result"]))
    if args.json:
        print(json.dumps({"reconciled": changed, "undelivered": rows},
                         ensure_ascii=False, indent=2))
        return
    for r in rows:
        print(f"{r['task_id']:34} {r['agent']:6} state={r['state']} "
              f"finished={r['finished_at']} result={r['result']}")


