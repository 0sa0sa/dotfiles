DOCTOR_MAX_RUNTIME_SECS = 7200
DOCTOR_STRANDED_SECS = 600
DOCTOR_REAP_AFTER_SECS = 120
DONE_STATES = ("done", "failed")


def diagnose_task(m, pane, result_status, now, idle_age, limits):
    """1 task の異常所見 [{code, severity, detail}] を返す純関数 (読み取りのみ).

    idle_age は最終活動からの秒数、limits は {max_runtime, stranded, reap_after}。
    """
    state = effective_state(m)
    if state == "killed" or m.get("pane_id") is None:  # pane_id None は spawn 途中の仮 manifest
        return []
    alive = pane is not None
    agent_status = pane.get("agent_status") if pane else None
    finished = state in DONE_STATES or result_status in DONE_STATES
    found = []

    def add(code, severity, detail):
        found.append({"code": code, "severity": severity, "detail": detail})

    if not alive and not finished and not m.get("delivered_at") \
            and state not in ("protocol_violation",):
        add("crashed", "error", "pane が消え、result なし")
    runtime = now - iso_to_epoch(m.get("created_at"))
    if alive and state == "running" and limits["max_runtime"] and runtime > limits["max_runtime"]:
        add("overtime", "warn", f"実行 {int(runtime)}s > --max-runtime {limits['max_runtime']}s")
    if alive and agent_status == "idle" and not finished and state not in TERMINAL_STATES \
            and idle_age > limits["stranded"]:
        add("stranded", "warn", f"idle のまま result なし ({int(idle_age)}s 活動なし)")
    if alive and finished and agent_status != "working" and idle_age > limits["reap_after"]:
        if state in DONE_STATES or m.get("delivered_at"):
            add("done_pane_alive", "info", f"{state} だが pane が {int(idle_age)}s 生存 (--reap で close)")
        else:  # result だけ done。wait 未実行のまま close すると gate/検証が飛ぶので reap 対象外
            add("done_unwaited", "info", f"result は {result_status} だが wait 未実行 (reap 対象外)")
    if state == "protocol_violation":
        add("protocol_violation", "warn", "Stop hook の催促を使い切っても result なし")
    return found


def parse_worktree_list(text):
    """git worktree list --porcelain → 本体を除く [{"path", "branch"}]."""
    entries = []
    for block in (text or "").split("\n\n"):
        fields = dict(line.split(" ", 1) for line in block.splitlines() if " " in line)
        if "worktree" in fields:
            branch = fields.get("branch", "").removeprefix("refs/heads/")
            entries.append({"path": fields["worktree"], "branch": branch})
    return entries[1:]


def find_orphan_worktrees(worktrees, tasks):
    """台帳と突き合わせた孤立 worktree [{path, branch, reason}] (純関数).

    ledger に無い delegate/dlg-* ブランチ、または kill/gone 済みなのに残っている worktree。
    tasks: [{"task_id", "worktree_path", "state", "removed"}]
    """
    by_path = {os.path.realpath(t["worktree_path"]): t for t in tasks if t.get("worktree_path")}
    ids = {t["task_id"] for t in tasks}
    orphans = []
    for wt in worktrees:
        task = by_path.get(os.path.realpath(wt["path"]))
        if task and task["state"] in ("killed", "gone") and not task["removed"]:
            orphans.append({**wt, "reason": f"{task['task_id']} は {task['state']} 済みで worktree が残存"})
        elif not task and wt["branch"].startswith("delegate/dlg-") \
                and wt["branch"].removeprefix("delegate/") not in ids:
            orphans.append({**wt, "reason": "台帳に無い delegate ブランチ"})
    return orphans


def last_activity_age(m, now):
    """最終活動からの秒数。transcript の mtime、無ければ台帳の最終 event/作成時刻."""
    finder = codex_transcript if m.get("agent") == "codex" else claude_transcript
    since = iso_to_epoch(m.get("created_at"))
    found = finder(m["cwd"], since, os.path.expanduser("~"))
    if found:
        return now - found[1] / 1e9
    events = m.get("events") or []
    return now - iso_to_epoch(events[-1]["ts"] if events else m.get("created_at"))


def ledger_worktrees():
    """台帳上の worktree task と、それらが属する repo のルート集合."""
    tasks, repos = [], set()
    for tid, _, m in iter_manifests():
        if m.get("worktree_path"):
            tasks.append({"task_id": tid, "worktree_path": m["worktree_path"],
                          "state": effective_state(m), "removed": bool(m.get("worktree_removed_at"))})
            if os.path.isdir(m["worktree_path"]):
                repos.add(git_repo_root(m["worktree_path"]))
    return tasks, repos - {None}


def orphan_findings(extra_repo):
    tasks, repos = ledger_worktrees()
    root = git_repo_root(extra_repo) if os.path.isdir(extra_repo) else None
    worktrees = {}
    for repo in repos | ({root} if root else set()):
        for wt in parse_worktree_list(run_git(repo, "worktree", "list", "--porcelain")):
            worktrees[wt["path"]] = wt
    return [{"task_id": None, "code": "orphan_worktree", "severity": "info",
             "detail": f"{o['path']} ({o['branch']}): {o['reason']}"}
            for o in find_orphan_worktrees(list(worktrees.values()), tasks)]


def cmd_doctor(args):
    panes = {p["pane_id"]: p for p in hcli("pane", "list").get("panes", [])}
    now = time.time()
    limits = {"max_runtime": args.max_runtime, "stranded": args.stranded_secs,
              "reap_after": args.reap_after}
    findings, owner = [], {}
    for tid, d, m in iter_manifests():
        pane = panes.get(m["pane_id"])
        for f in diagnose_task(m, pane, read_result_status(d), now,
                               last_activity_age(m, now), limits):
            findings.append({"task_id": tid, **f})
            owner[tid] = (d, m)
    findings += orphan_findings(args.cwd or os.getcwd())
    reaped = []
    if args.reap:
        for f in [f for f in findings if f["code"] == "done_pane_alive"]:
            d, m = owner[f["task_id"]]
            save_recovery(d, effective_state(m))
            hcli("pane", "close", m["pane_id"])
            reaped.append(f["task_id"])
        findings = [f for f in findings if f["task_id"] not in reaped or f["code"] != "done_pane_alive"]
    if args.json:
        print(json.dumps({"findings": findings, "reaped": reaped}, ensure_ascii=False, indent=2))
    else:
        for tid in reaped:
            print(f"[reaped] {tid} pane を close")
        for f in findings:
            print(f"[{f['severity']}] {f['task_id'] or '-':34} {f['code']}: {f['detail']}")
        if not findings and not reaped:
            print("OK: 異常なし")
    sys.exit(1 if findings else 0)


