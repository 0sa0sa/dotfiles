    # wrapper スクリプトの $cwd / $prompt シェル変数として展開される
    "claude": 'exec claude {model} {danger} {settings} "$prompt"',
    "codex": 'exec codex {model} {danger} --cd "$cwd" "$prompt"',
}
DANGER_FLAGS = {
    "claude": "--dangerously-skip-permissions",
    "codex": "--dangerously-bypass-approvals-and-sandbox",
}
MODEL_FLAGS = {"claude": "--model {m}", "codex": "-m {m}"}


STOP_HOOK = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                         "hooks", "herdr-delegate-stop.py")
# worker の deny フロア: --dangerously-skip-permissions でも deny は先に評価される
DENY_FLOOR = (
    "Bash(git push --force*)",
    "Bash(git push -f*)",
    "Bash(rm -rf /)",
    "Bash(rm -rf /*)",
    "Bash(rm -rf ~*)",
