# ---------- pure helpers ----------

def slugify(text):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:20].rstrip("-") or "task"


def new_task_id(slug, base_dir):
    tid = f"dlg-{time.strftime('%H%M%S')}-{slug}"
    while os.path.exists(os.path.join(base_dir, tid)):
        suffix = "".join(random.choices(string.hexdigits.lower(), k=2))
        tid = f"dlg-{time.strftime('%H%M%S')}-{slug}-{suffix}"
    return tid


EVIDENCE_HEADING = "## Verification evidence"
CONTRACT_FIELDS = (("verify", "検証方法"), ("constraints", "制約"), ("stop_when", "停止条件"))


def build_contract(verify, constraints, stop_when):
    """--verify/--constraints/--stop-when → {key: text} (全て空なら None)."""
    given = {"verify": verify, "constraints": constraints, "stop_when": stop_when}
    contract = {k: v.strip() for k, v in given.items() if v and v.strip()}
    return contract or None


def contract_section(contract):
    """契約フッターの「## Contract」節 (contract が無ければ "")."""
    if not contract:
        return ""
    lines = [f"- {label}: {contract[key]}" for key, label in CONTRACT_FIELDS if key in contract]
    return ("\n## Contract\n" + "\n".join(lines) + "\n"
            f"result.md に「{EVIDENCE_HEADING}」節を書き、検証で実行したコマンドと出力要約を示すこと"
            "(result.json なら verification_evidence キー)。無い完了報告は blocked 扱いになる。\n")


def contract_footer(task_dir, schema=None, contract=None):
    result = os.path.join(task_dir, "result.md")
    footer = f"""
--- 委任契約 ---
完了したら {result} に以下の形式で書き込むこと:
  status: done|failed
  summary: 結果 3-10 行
  artifacts: 変更ファイル/ブランチ/PR URL の列挙
result.md を書くまでタスク完了とみなされない。
質問・承認が必要なら result.md に status: blocked と理由を書いて停止。
blocked のときは kind: ({"|".join(BLOCK_KINDS)}) と question: (質問本文) も書くこと。
"""
    footer += contract_section(contract)
    if schema:
        footer += f"""
構造化結果: {os.path.join(task_dir, "result.json")} に JSON のみで書くこと (result.md の代わり)。
  キー: status(done|failed|blocked), summary(string), artifacts(array of string), {describe_schema(schema)}
"""
    return footer


RESULT_STATUSES = ("done", "failed", "blocked")
BLOCK_KINDS = ("needs_input", "capability", "transient", "dependency")
_RESULT_KEY_RE = re.compile(r"\s*(status|summary|artifacts|kind|question):\s*(.*)$", re.IGNORECASE)


def describe_schema(schema):
    """契約フッター用に --schema の必須キーと型を1行で説明する."""
    props = schema.get("properties", {})
    required = schema.get("required", [])
    parts = [f"{k}({props.get(k, {}).get('type', 'any')})" for k in required]
    return "必須: " + ", ".join(parts) if parts else "追加の必須キーなし"


def md_status(text):
    """result.md 本文の status 行 (done|failed|blocked)。無い/未知の値は None."""
    for line in text.splitlines():
        m = re.match(r"\s*status:\s*(\w+)", line, re.IGNORECASE)
        if m and m.group(1).lower() in RESULT_STATUSES:
            return m.group(1).lower()
    return None


def parse_result_md(text):
    """result.md を {status, summary, artifacts, kind, question} に解釈する純関数.

    `key:` 行から次の key 行 (または markdown 見出し `## ...`) までを値とする。
    artifacts は箇条書き/カンマ区切りを分解。
    """
    blocks, cur = {}, None
    for line in text.splitlines():
        m = _RESULT_KEY_RE.match(line)
        if _HEADING_RE.match(line):
            cur = None  # "## Verification evidence" 等の別節は値に含めない
        elif m:
            cur = m.group(1).lower()
            blocks[cur] = [m.group(2)]
        elif cur:
            blocks[cur].append(line)
    flat = {k: "\n".join(v).strip() for k, v in blocks.items()}
    return {
        "status": md_status(text),
        "summary": flat.get("summary", ""),
        "artifacts": split_artifacts(flat.get("artifacts", "")),
        "kind": flat.get("kind") or None,
        "question": flat.get("question") or None,
    }


_HEADING_RE = re.compile(r"\s{0,3}#{1,6}\s")
_OPEN, _CLOSE = "([（", ")]）"


def split_top_level_commas(line):
    """括弧の外側のカンマ (、全角含む) でだけ分割する. "a.py (new, untracked)" は1要素."""
    parts, buf, depth = [], [], 0
    for ch in line:
        if ch in _OPEN:
            depth += 1
        elif ch in _CLOSE and depth:
            depth -= 1
        if ch in ",，" and depth == 0:
            parts.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    parts.append("".join(buf))
    return [x.strip() for x in parts if x.strip()]


def split_artifacts(text):
    items = []
    for line in text.splitlines():
        line = re.sub(r"^\s*[-*•]\s*", "", line).strip()
        if line:
            items.extend(split_top_level_commas(line))
    return items


def normalize_kind(kind):
    """blocked の kind。未記載・未知は needs_input."""
    k = (kind or "").strip().lower()
    return k if k in BLOCK_KINDS else "needs_input"


def parse_result_json(text):
    """result.json 本文 → dict。不正 JSON / status 不正は None."""
    try:
        data = json.loads(text)
    except ValueError:
        return None
    if not isinstance(data, dict) or data.get("status") not in RESULT_STATUSES:
        return None
    return {
        "status": data["status"],
        "summary": str(data.get("summary", "")),
        "artifacts": [str(a) for a in data.get("artifacts") or []],
        "kind": data.get("kind"),
        "question": data.get("question"),
        "raw": data,
    }


def _read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def load_result(task_dir):
    """worker の結果を {status, summary, artifacts, kind, question, source} で返す.

    result.json (構造化) を優先し、無い/不正なら result.md。status が確定しなければ None。
    """
    text = _read_text(os.path.join(task_dir, "result.json"))
    res = parse_result_json(text) if text is not None else None
    if res:
        res["source"] = "result.json"
        return res
    text = _read_text(os.path.join(task_dir, "result.md"))
    res = parse_result_md(text) if text is not None else None
    if res and res["status"]:
        res["source"] = "result.md"
        return res
    return None


def read_result_status(task_dir):
    """結果の status (done|failed|blocked)。ファイル無し / status 行なし / 未知の値は None.

    旧実装は status 行なしを done 扱いにして、書きかけ・古い result.md を
    完了と誤認した。None なら decide() が NUDGE で status 行を促す。
    """
    res = load_result(task_dir)
    return res["status"] if res else None


JSON_TYPES = {"string": str, "integer": int, "number": (int, float), "boolean": bool,
              "array": list, "object": dict, "null": type(None)}
MAX_SCHEMA_ERRORS = 10


def validate_result(data, schema):
    """--schema (required + properties.type のみの簡易検証) に対するエラー文のリスト."""
    if not isinstance(data, dict):
        return ["result.json がオブジェクトでない"]
    errors = [f"必須キー {k} がない" for k in schema.get("required", []) if k not in data]
    for key, spec in schema.get("properties", {}).items():
        want = JSON_TYPES.get(spec.get("type"))
        if key in data and want and not _type_ok(data[key], spec["type"], want):
            errors.append(f"{key} は {spec['type']} であること")
    return errors[:MAX_SCHEMA_ERRORS]


def _type_ok(value, name, want):
    if isinstance(value, bool) and name in ("integer", "number"):
        return False
    return isinstance(value, want)


def schema_errors(task_dir, schema):
    """task の result.json を schema で検証 (result.json が無い/不正 JSON もエラー)."""
    text = _read_text(os.path.join(task_dir, "result.json"))
    try:
        data = json.loads(text) if text is not None else None
    except ValueError:
        data = None
    if data is None:
        return ["result.json が存在しない/不正な JSON"]
    return validate_result(data, schema)


SCHEMA_SETTLE_SECS = 60


def schema_gate_action(errors, corrected_at, result_mtime, now, settle=SCHEMA_SETTLE_SECS):
    """スキーマ違反への対応: ok|correct(補正を1回送る)|wait(補正後の書き直し待ち)|invalid_final."""
    if not errors:
        return "ok"
    if corrected_at is None:
        return "correct"
    if result_mtime is not None and result_mtime > corrected_at:
        return "invalid_final"  # 補正後に書き直したがまだ違反
    return "wait" if now - corrected_at < settle else "invalid_final"


def looks_like_path(item):
    """artifacts の要素がファイルパスらしいか (URL・ブランチ名・説明文は除外)."""
    if "://" in item or re.search(r"\s", item):
        return False
    return item.startswith(("/", "./", "../", "~")) or bool(re.search(r"\.\w+$", item))


def resolve_artifacts(items, base_dir, exists=os.path.exists):
    """artifacts を絶対パス化し [{"raw","path","missing"}] を返す (パス以外はそのまま)."""
    out = []
    for raw in items:
        if not looks_like_path(raw):
            out.append({"raw": raw, "path": None, "missing": False})
            continue
        path = os.path.normpath(os.path.join(base_dir, os.path.expanduser(raw)))
        out.append({"raw": raw, "path": path, "missing": not exists(path)})
    return out


def markdown_has_evidence(text):
    """result.md に中身のある「## Verification evidence」節があるか."""
    m = re.search(r"^#{1,6}\s*verification evidence\s*$(.*?)(?=^#{1,6}\s|\Z)",
                  text, re.IGNORECASE | re.MULTILINE | re.DOTALL)
    return bool(m and m.group(1).strip())


def result_has_evidence(task_dir):
    """完了報告に検証証跡があるか (result.json は verification_evidence キー)."""
    res = load_result(task_dir)
    if res and res["source"] == "result.json":
        return bool(str(res["raw"].get("verification_evidence", "")).strip())
    return markdown_has_evidence(_read_text(os.path.join(task_dir, "result.md")) or "")


DEFAULT_GATE_TIMEOUT = 300
DEFAULT_GATE_RETRIES = 3
GATE_TAIL_BYTES = 3072
GATE_TIMEOUT_RC = 124


def tail_bytes(text, limit=GATE_TAIL_BYTES):
    """text の末尾 limit バイト (UTF-8 の途中で切れた先頭文字は捨てる)."""
    return text.encode("utf-8", "replace")[-limit:].decode("utf-8", "ignore")


def gate_verdict(failures, retries):
    """gate 失敗の累計回数 (今回を含む) から: retry(差し戻す) | exhausted(打ち切る)."""
    return "retry" if failures < retries else "exhausted"


def gate_feedback(cmd, rc, output, failures, retries):
    """gate 失敗を worker に差し戻す1行メッセージ (出力末尾 3KB 付き)."""
    reason = "タイムアウト" if rc == GATE_TIMEOUT_RC else f"終了コード {rc}"
    return (f"決定論 gate が失敗 ({failures}/{retries}): `{cmd}` {reason}。"
            f"出力末尾: {tail_bytes(output).strip()} "
            "── 修正して gate を通してから result.md を書き直すこと。")


def run_gate(cmd, cwd, timeout):
    """gate コマンドを cwd で実行し (rc, 出力) を返す。タイムアウトは rc=124."""
    proc = subprocess.Popen(cmd, shell=True, cwd=cwd, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, errors="replace",
                            stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)  # shell の子孫 (サーバ等) も道連れにする
        out, _ = proc.communicate()
        return GATE_TIMEOUT_RC, (out or "") + f"\n[timeout {timeout}s]"
    return proc.returncode, out


def clamp_gate_timeout(timeout, deadline, now):
    """gate の制限秒数を wait の残り時間 (deadline 無しなら無制限) で頭打ちにする。最低 1 秒."""
    if deadline is None:
        return timeout
    return max(1, min(timeout, deadline - now))


def first_gate_failure(gates, cwd, timeout, run=run_gate):
    """gate を順に実行し、最初の失敗 (cmd, rc, output)。全成功は None."""
    for cmd in gates:
        rc, out = run(cmd, cwd, timeout)
        if rc != 0:
            return cmd, rc, out
    return None


RESULT_FILES = ("md", "json")


def archive_result(task_dir):
    """既存 result.md / result.json を result.<n>.* に退避し、退避先パスを返す (無ければ None).

    再投入 (send) 後に古い result を完了と誤読しないため。戻り値は退避した最初のファイル。
    """
    present = [e for e in RESULT_FILES if os.path.exists(os.path.join(task_dir, f"result.{e}"))]
    if not present:
        return None
    n = 1
    while any(os.path.exists(os.path.join(task_dir, f"result.{n}.{e}")) for e in RESULT_FILES):
        n += 1
    for e in present:
        os.replace(os.path.join(task_dir, f"result.{e}"),
                   os.path.join(task_dir, f"result.{n}.{e}"))
    return os.path.join(task_dir, f"result.{n}.{present[0]}")


def restore_result(task_dir, archived):
    """archive_result で退避した result を元に戻す (archived が None なら何もしない)."""
    if not archived:
        return
    stem = archived.rsplit(".", 1)[0]
    for e in RESULT_FILES:
        if os.path.exists(f"{stem}.{e}"):
            os.replace(f"{stem}.{e}", os.path.join(task_dir, f"result.{e}"))


STALL_GRACE_SECS = 60        # 催促後も idle のまま result なし → STALLED
NUDGE_INTERVAL_SECS = 20     # 催促の間隔 (2回目以降)
MAX_NUDGES = 2
DEFAULT_STALL_SECS = 600     # working なのに進捗なし → 1回通知
DEFAULT_STALL_GRACE = 300    # 通知後さらに進捗なし → QUIET (exit 5)


def decide(agent_status, result_status, nudges, idle_secs, timed_out=False,
           quiet_secs=0, stall_secs=0, stall_grace=DEFAULT_STALL_GRACE,
           already_notified=False, protocol_violation=False, limited=False):
    """wait ループの1判定.

    戻り値: CONTINUE|NUDGE|STALL_NOTIFY|DONE|FAILED_RESULT|BLOCKED|STALLED|QUIET
            |PROTOCOL_VIOLATION|LIMITED|PANE_GONE|TIMEOUT
    nudges は送信済みの催促回数 (bool も可)。quiet_secs は working 中に進捗が無い秒数、
    stall_secs=0 で進捗監視を無効化。already_notified は STALL_NOTIFY 済みのラッチ。
    limited は pane 末尾に枠切れ表示がある (idle/blocked で result なしのときだけ呼び出し側が立てる)。
    timed_out は --timeout 超過。完了/失敗/blocked/pane 消失より弱く、
    継続系 (CONTINUE/NUDGE/STALL_NOTIFY/QUIET) の場面でだけ TIMEOUT に置き換わる。
    """
    if agent_status == "working" and result_status != "blocked":
        action = _decide_working(quiet_secs, stall_secs, stall_grace, already_notified)
    else:
        action = _decide_base(agent_status, result_status, nudges, idle_secs,
                              protocol_violation, limited)
    if timed_out and action in ("CONTINUE", "NUDGE", "STALL_NOTIFY", "QUIET"):
        return "TIMEOUT"
    return action


def _decide_working(quiet_secs, stall_secs, stall_grace, already_notified):
    if not stall_secs or quiet_secs < stall_secs:
        return "CONTINUE"
    if not already_notified:
        return "STALL_NOTIFY"
    return "QUIET" if quiet_secs >= stall_secs + stall_grace else "CONTINUE"


def _decide_base(agent_status, result_status, nudges, idle_secs, protocol_violation,
                 limited=False):
    if agent_status is None:
        return "PANE_GONE"
    if limited and result_status is None:
        return "LIMITED"
    if result_status == "blocked" or agent_status == "blocked":
        return "BLOCKED"
    # idle / unknown
    if result_status == "done":
        return "DONE"
    if result_status == "failed":
        return "FAILED_RESULT"
    if protocol_violation:
        return "PROTOCOL_VIOLATION"
    if nudges == 0 or (nudges < MAX_NUDGES and idle_secs > NUDGE_INTERVAL_SECS):
        return "NUDGE"
    if nudges >= MAX_NUDGES and idle_secs > STALL_GRACE_SECS:
        return "STALLED"
    return "CONTINUE"


