#!/usr/bin/env python3
"""herdr-orch — オーケストレーター用の記憶層 CLI (ボード / 教訓 / ミッション / 統計).

サブコマンド: board / lessons / mission / stats / recommend / context / brief
データ: $HERDR_ORCH_DIR (既定 ~/.config/herdr/orchestrator) 0700, ファイル 0600
台帳 (読み取り専用): $HERDR_DELEGATE_DIR (既定 ~/.config/herdr/delegate/tasks)
context / brief は SessionStart・委任時に呼ばれるので、何があっても exit 0。
"""

import argparse
import collections
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
import random
import re
import shlex
import sys
import tempfile
import time

TERMINAL_OK = ("done", "killed", "running")  # lessons capture の対象外 state
TERMINAL_STATES = ("done", "failed", "blocked", "gone", "killed", "protocol_violation",
                   "timeout", "limited")
KINDS = ("note", "claim", "finding", "done")
CONTRACT_MARK = "--- 委任契約 ---"
CONTEXT_LIMIT = 4000
MAX_DURATION = 100 * 365 * 86400  # fromtimestamp の OverflowError 回避
MAX_ENTRY_BYTES = 8192  # board 1 エントリの上限
CTX_BEGIN = "<!-- herdr-orch:context -->"
CTX_END = "<!-- /herdr-orch:context -->"
PARENT_END = "<!-- /herdr-delegate:parent -->"


# ---------- paths / io ----------

def orch_dir():
    return os.environ.get("HERDR_ORCH_DIR") or os.path.expanduser("~/.config/herdr/orchestrator")


def tasks_dir():
    return os.environ.get("HERDR_DELEGATE_DIR") or os.path.expanduser(
        "~/.config/herdr/delegate/tasks")


def ensure_dir(path):
    """0700 でディレクトリを作る (親も作る)."""
    old = os.umask(0o077)
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
    finally:
        os.umask(old)
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass


def sub_dir(name):
    d = os.path.join(orch_dir(), name)
    ensure_dir(d)
    return d


def open_private(path, flags):
    old = os.umask(0o077)
    try:
        fd = os.open(path, flags | os.O_CREAT, 0o600)
    finally:
        os.umask(old)
    try:
        os.fchmod(fd, 0o600)
    except OSError:
        pass
    return fd


@contextlib.contextmanager
def locked(path):
    """path.lock に対する排他 flock."""
    ensure_dir(os.path.dirname(path))
    fd = open_private(path + ".lock", os.O_RDWR)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)  # close で unlock


def atomic_write(path, text):
    ensure_dir(os.path.dirname(path))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="replace") as f:
            f.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except (OSError, ValueError):
        return None


def read_json(path):
    t = read_text(path)
    if t is None:
        return None
    try:
        return json.loads(t)
    except ValueError:
        return None


def now_iso():
    return datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")


def parse_ts(s):
    """ISO8601 風文字列 → epoch (不能なら None)."""
    if not isinstance(s, str) or not s:
        return None
    for fmt in ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.datetime.strptime(s, fmt).timestamp()
        except ValueError:
            continue
    try:
        return datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def parse_duration(s):
    """'90d' '12h' '2w' '30m' → 秒。'0' → 0 (無期限/無制限)。不正は ValueError."""
    s = str(s).strip().lower()
    m = re.fullmatch(r"(\d+)\s*([smhdw]?)", s)
    if not m:
        raise ValueError(f"期間の形式が不正: {s}")
    secs = int(m.group(1)) * {"": 86400, "s": 1, "m": 60, "h": 3600, "d": 86400,
                              "w": 604800}[m.group(2)]
    return min(secs, MAX_DURATION)


def read_text_arg(text):
    """TEXT が '-' なら stdin."""
    return sys.stdin.read() if text == "-" else text


def die(msg, code=1):
    print(f"herdr-orch: {msg}", file=sys.stderr)
    sys.exit(code)


def emit_json(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=2))


def first_line(text, limit=200):
    for line in (text or "").splitlines():
        if line.strip():
            return line.strip()[:limit]
    return ""


# ---------- slug ----------

def group_slug(name):
    """パス安全な slug。slug 化で名前が変わる場合は元名の sha1[:6] を付けて衝突を避ける."""
    name = str(name or "")
    s = re.sub(r"[^A-Za-z0-9._-]", "-", name).lstrip(".")[:64]
    if s == name and s:
        return s
    h = hashlib.sha1(name.encode("utf-8", "replace")).hexdigest()[:6]
    return f"{s[:57] or 'group'}-{h}"


ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def mission_id_from(raw):
    """明示 --id → ID_RE 準拠 (不正文字は '-'、先頭の非英数字は除去). 空なら None."""
    s = re.sub(r"[^A-Za-z0-9._-]", "-", str(raw or ""))
    s = re.sub(r"^[^A-Za-z0-9]+", "", s)[:64]
    return s or None


def mission_slug(title):
    s = re.sub(r"[^a-z0-9._-]+", "-", str(title).lower()).strip("-.")[:48].strip("-.")
    return s or "mission"


def check_id(x, what="ID"):
    if not isinstance(x, str) or not ID_RE.match(x):
        die(f"{what} が不正: {x!r}")
    return x


# ---------- board ----------

ENTRY_RE = re.compile(r"^- \[([^\]]*)\] \[([^\]]*)\] \(([^)]*)\) ?(.*)$")


def board_file(group, create=False):
    path = os.path.join(sub_dir("boards"), group_slug(group) + ".md")
    if create and not os.path.exists(path):
        os.close(open_private(path, os.O_WRONLY | os.O_APPEND))
    return path


def board_file_nocreate(group):
    return os.path.join(orch_dir(), "boards", group_slug(group) + ".md")


def format_entry(ts, kind, task, text):
    lines = text.strip("\n").splitlines() or [""]
    task = re.sub(r"[\s()]+", "-", task or "").strip("-")
    out = [f"- [{ts}] [{kind}] ({task}) {lines[0]}"]
    out += ["  " + ln for ln in lines[1:]]
    return "\n".join(out) + "\n"


def parse_board(text):
    entries, cur = [], None
    for line in (text or "").splitlines():
        m = ENTRY_RE.match(line)
        if m:
            cur = {"ts": m.group(1), "kind": m.group(2), "task": m.group(3), "text": m.group(4)}
            entries.append(cur)
        elif cur is not None and line.startswith("  "):
            cur["text"] += "\n" + line[2:]
        elif cur is not None and not line.strip():
            cur["text"] += "\n"
    for e in entries:
        e["text"] = e["text"].rstrip("\n")
    return entries


def load_board(group):
    return parse_board(read_text(board_file_nocreate(group)))


_CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")  # \n と \t 以外の制御文字 (ESC 含む)


def clean_text(text, limit=MAX_ENTRY_BYTES):
    """制御文字を除去し、UTF-8 で limit バイトに切る."""
    text = _CTRL_RE.sub("", str(text).replace("\r\n", "\n"))
    b = text.encode("utf-8", "replace")
    if len(b) <= limit:
        return b.decode("utf-8")
    return b[:limit].decode("utf-8", "ignore") + "…(truncated)"


def cmd_board_post(a):
    text = clean_text(read_text_arg(a.text))
    if not text.strip():
        die("TEXT が空")
    entry = format_entry(now_iso(), a.kind, clean_text(a.task or "", 200), text)
    path = board_file(a.group)
    fd = open_private(path, os.O_WRONLY | os.O_APPEND)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        os.write(fd, entry.encode("utf-8", "replace"))  # 1 回の write で追記 (flock 下)
    finally:
        os.close(fd)
    return 0


def cmd_board_show(a):
    entries = load_board(a.group)
    if a.tail is not None and a.tail < 0:
        die("--tail は 0 以上", 2)
    if a.tail is not None:
        entries = entries[-a.tail:] if a.tail else []
    if a.json:
        emit_json(entries)
    else:
        for e in entries:
            print(format_entry(e["ts"], e["kind"], e["task"], e["text"]), end="")
    return 0


def cmd_board_path(a):
    print(os.path.abspath(board_file(a.group, create=True)))
    return 0


def active_claims(entries):
    """kind=claim で同じ task の後続 done が無いもの."""
    out = []
    for i, e in enumerate(entries):
        if e["kind"] != "claim":
            continue
        if e["task"] and any(x["kind"] == "done" and x["task"] == e["task"]
                             for x in entries[i + 1:]):
            continue
        out.append(e)
    return out


def cmd_board_claims(a):
    claims = active_claims(load_board(a.group))
    if a.json:
        emit_json(claims)
    else:
        for e in claims:
            print(format_entry(e["ts"], e["kind"], e["task"], e["text"]), end="")
    return 0


# ---------- lessons ----------

def lessons_path():
    return os.path.join(orch_dir(), "lessons.jsonl")


def load_lessons():
    out = []
    for line in (read_text(lessons_path()) or "").splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("id"):
            out.append(d)
    return out


def save_lessons(items):
    atomic_write(lessons_path(),
                 "".join(json.dumps(d, ensure_ascii=False) + "\n" for d in items))


def new_lesson_id(existing):
    while True:
        lid = "L" + time.strftime("%y%m%d%H%M%S") + "-" + "%04x" % random.randrange(0x10000)
        if lid not in existing:
            return lid


def is_expired(d, now=None):
    exp = d.get("expires_at")
    if not exp:
        return False
    t = parse_ts(exp)
    return t is not None and t <= (now or time.time())


def add_lesson(text, tags=(), task=None, ttl="90d", status="active"):
    secs = parse_duration(ttl)
    ensure_dir(orch_dir())
    with locked(lessons_path()):
        items = load_lessons()
        lid = new_lesson_id({d["id"] for d in items})
        exp = None if secs == 0 else datetime.datetime.fromtimestamp(
            time.time() + secs).astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        d = {"id": lid, "ts": now_iso(), "tags": list(tags), "text": text,
             "source_task": task, "expires_at": exp, "status": status}
        fd = open_private(lessons_path(), os.O_WRONLY | os.O_APPEND)
        try:
            os.write(fd, (json.dumps(d, ensure_ascii=False) + "\n").encode("utf-8", "replace"))
        finally:
            os.close(fd)
    return d


def split_tags(s):
    return [t.strip() for t in (s or "").split(",") if t.strip()]


def cmd_lessons_add(a):
    text = read_text_arg(a.text).strip()
    if not text:
        die("TEXT が空")
    try:
        d = add_lesson(text, split_tags(a.tags), a.task, a.ttl)
    except ValueError as e:
        die(str(e))
    print(d["id"])
    return 0


def cmd_lessons_list(a):
    items = load_lessons()
    if not a.all:
        items = [d for d in items if d.get("status") == "active" and not is_expired(d)]
    if a.tag:
        items = [d for d in items if a.tag in (d.get("tags") or [])]
    if a.json:
        emit_json(items)
        return 0
    for d in items:
        flag = ""
        if d.get("status") != "active":
            flag = f" ({d.get('status')})"
        if is_expired(d):
            flag += " (expired)"
        print(f"{d['id']}{flag} [{','.join(d.get('tags') or [])}] {first_line(d.get('text'), 200)}")
    return 0


def _mutate_lesson(lid, fn):
    with locked(lessons_path()):
        items = load_lessons()
        hit = [d for d in items if d["id"] == lid]
        if not hit:
            die(f"lesson が無い: {lid}")
        items = fn(items, hit[0])
        save_lessons(items)


def cmd_lessons_forget(a):
    _mutate_lesson(a.id, lambda items, d: [x for x in items if x is not d])
    return 0


def cmd_lessons_promote(a):
    def fn(items, d):
        d["status"] = "active"
        print(f"promoted {d['id']} (注入される全文):\n{d.get('text')}", file=sys.stderr)
        return items
    _mutate_lesson(a.id, fn)
    return 0


def cmd_lessons_prune(a):
    with locked(lessons_path()):
        items = load_lessons()
        keep = [d for d in items if not is_expired(d)]
        if len(keep) != len(items):
            save_lessons(keep)
    print(f"pruned {len(items) - len(keep)}")
    return 0


STOP = {"the", "and", "for", "with", "this", "that", "are", "was", "you", "not", "から", "ので"}


def tokens(text):
    """英数語 (小文字, 2 字以上) + CJK 2-gram の集合."""
    text = (text or "").lower()
    out = {w for w in re.findall(r"[a-z0-9][a-z0-9_.-]*", text) if len(w) >= 2}
    for w in list(out):
        out.update(p for p in re.split(r"[_.-]", w) if len(p) >= 2)
    for run in re.findall(r"[぀-ヿ㐀-鿿豈-﫿]+", text):
        out.update(run[i:i + 2] for i in range(len(run) - 1))
    return out - STOP


def score_lesson(d, ptok, agent=None):
    tag_tok = set()
    for t in d.get("tags") or []:
        tag_tok |= tokens(str(t)) | {str(t).lower()}
    s = 2 * len(tag_tok & ptok) + len(tokens(d.get("text")) & ptok)
    if agent and agent.lower() in [str(t).lower() for t in d.get("tags") or []]:
        s += 3
    return s


def relevant_lessons(prompt, agent=None, limit=5):
    ptok = tokens(prompt)
    scored = []
    for d in load_lessons():
        if d.get("status") != "active" or is_expired(d):
            continue
        s = score_lesson(d, ptok, agent)
        if s > 0:
            scored.append((s, d.get("ts") or "", d))
    scored.sort(key=lambda x: (x[0], x[1]), reverse=True)
    return [d for _, _, d in scored[:limit]]


def cmd_lessons_relevant(a):
    if a.prompt_file:
        prompt = read_text(a.prompt_file) or ""
    elif a.text is not None:
        prompt = a.text
    else:
        die("--prompt-file か --text が必要", 2)
    items = relevant_lessons(prompt, a.agent, a.limit)
    if a.json:
        emit_json(items)
    else:
        for d in items:
            print(f"{d['id']} [{','.join(d.get('tags') or [])}] {first_line(d.get('text'), 200)}")
    return 0


def cmd_lessons_capture(a):
    tid = a.task_id
    if os.path.basename(tid) != tid or tid.startswith("."):
        die(f"task_id が不正: {tid}")
    tdir = os.path.join(tasks_dir(), tid)
    m = read_json(os.path.join(tdir, "manifest.json"))
    if not isinstance(m, dict):
        die(f"manifest が読めない: {tid}")
    state = as_str(m.get("state"))
    if not state or state in TERMINAL_OK:
        return 0
    res = read_result(tdir)
    reason = as_str(m.get("exit_reason"))
    tags = [as_str(m.get("agent")), as_str(m.get("model")), state, reason, res.get("kind"),
            classify(task_prompt_text(tdir))]
    seen, uniq = set(), []
    for t in tags:
        if t and str(t) not in seen:
            seen.add(str(t))
            uniq.append(str(t))
    detail = (first_line(res.get("question")) if state == "blocked" else "") \
        or first_line(res.get("summary")) or first_line(res.get("question")) or str(reason or state)
    label = as_str(m.get("label")) or tid
    text = f"{label}: {state} — {detail}"[:200]
    add_lesson_unique(text, uniq, tid)
    return 0


def add_lesson_unique(text, tags, tid):
    """capture 用: candidate の重複確認と追記を 1 ロックで行う."""
    with locked(lessons_path()):
        items = load_lessons()
        if any(d.get("source_task") == tid and d.get("status") == "candidate" for d in items):
            return
        d = {"id": new_lesson_id({x["id"] for x in items}), "ts": now_iso(), "tags": tags,
             "text": text, "source_task": tid, "status": "candidate",
             "expires_at": datetime.datetime.fromtimestamp(
                 time.time() + 90 * 86400).astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")}
        fd = open_private(lessons_path(), os.O_WRONLY | os.O_APPEND)
        try:
            os.write(fd, (json.dumps(d, ensure_ascii=False) + "\n").encode("utf-8", "replace"))
        finally:
            os.close(fd)


# ---------- missions ----------

def missions_dir():
    return sub_dir("missions")


def mission_path(mid):
    return os.path.join(missions_dir(), check_id(mid, "mission ID") + ".json")


def as_str(v):
    """str / int のみ文字列化、それ以外 (list/dict/bool/None) は None."""
    if isinstance(v, str):
        return v
    if isinstance(v, int) and not isinstance(v, bool):
        return str(v)
    return None


def normalize_mission(d):
    """型が壊れた mission JSON を安全な形に直す (notes/decisions は dict 要素のみ)."""
    for k in ("id", "title", "goal", "status", "created_at", "updated_at"):
        d[k] = as_str(d.get(k)) or ""
    for k in ("notes", "decisions"):
        v = d.get(k)
        d[k] = [{"ts": as_str(e.get("ts")) or "", "text": as_str(e.get("text")) or ""}
                for e in v if isinstance(e, dict)] if isinstance(v, list) else []
    return d


def load_mission(mid):
    d = read_json(mission_path(mid)) if ID_RE.match(str(mid)) else None
    return normalize_mission(d) if isinstance(d, dict) else None


def save_mission(d):
    atomic_write(mission_path(d["id"]), json.dumps(d, ensure_ascii=False, indent=2) + "\n")


def all_missions():
    out = []
    d = os.path.join(orch_dir(), "missions")
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for n in names:
        if n.endswith(".json"):
            m = read_json(os.path.join(d, n))
            if isinstance(m, dict) and as_str(m.get("id")):
                out.append(normalize_mission(m))
    return out


def cmd_mission_new(a):
    base = (mission_id_from(a.id) if a.id else None) or mission_slug(a.title)
    ensure_dir(missions_dir())
    now = now_iso()
    n = 1
    while True:
        mid = base if n == 1 else f"{base}-{n}"
        try:
            fd = os.open(mission_path(mid), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            break
        except FileExistsError:
            n += 1
    d = {"id": mid, "title": a.title, "goal": a.goal or "", "status": "active",
         "created_at": now, "updated_at": now, "notes": [], "decisions": []}
    with os.fdopen(fd, "w", encoding="utf-8", errors="replace") as f:
        f.write(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
    print(mid)
    return 0


def cmd_mission_list(a):
    ms = all_missions()
    if not a.all:
        ms = [m for m in ms if m.get("status") == "active"]
    if a.json:
        emit_json(ms)
    else:
        for m in ms:
            print(f"{m['id']} [{m.get('status')}] {m.get('title', '')}")
    return 0


def mission_tasks(mid):
    out = []
    try:
        names = sorted(os.listdir(tasks_dir()))
    except OSError:
        return out
    for n in names:
        m = read_json(os.path.join(tasks_dir(), n, "manifest.json"))
        if isinstance(m, dict) and m.get("mission") == mid:
            out.append({"task_id": as_str(m.get("task_id")) or n, "state": as_str(m.get("state")),
                        "label": as_str(m.get("label"))})
    return out


def cmd_mission_show(a):
    m = load_mission(a.id)
    if not m:
        die(f"mission が無い: {a.id}")
    tasks = mission_tasks(a.id)
    if a.json:
        emit_json(dict(m, tasks=tasks))
        return 0
    print(f"{m['id']} [{m.get('status')}] {m.get('title', '')}")
    if m.get("goal"):
        print(f"goal: {m['goal']}")
    for key in ("decisions", "notes"):
        if m.get(key):
            print(f"{key}:")
            for e in m[key]:
                print(f"  - [{e.get('ts')}] {e.get('text')}")
    if tasks:
        print("tasks:")
        for t in tasks:
            print(f"  - {t['task_id']} {t['state']} {t['label'] or ''}".rstrip())
    return 0


def _mission_append(mid, key, text):
    text = read_text_arg(text).strip()
    if not text:
        die("TEXT が空")
    with locked(mission_path(mid)):
        m = load_mission(mid)
        if not m:
            die(f"mission が無い: {mid}")
        now = now_iso()
        m.setdefault(key, []).append({"ts": now, "text": text})
        m["updated_at"] = now
        save_mission(m)


def cmd_mission_note(a):
    _mission_append(a.id, "notes", a.text)
    return 0


def cmd_mission_decide(a):
    _mission_append(a.id, "decisions", a.text)
    return 0


def cmd_mission_close(a):
    with locked(mission_path(a.id)):
        m = load_mission(a.id)
        if not m:
            die(f"mission が無い: {a.id}")
        m["status"] = a.status
        m["updated_at"] = now_iso()
        save_mission(m)
    return 0


def current_key():
