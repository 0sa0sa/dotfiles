    for o in ("--group", "--mission", "--prompt-file", "--agent", "--task"):
        x.add_argument(o)
    x = sub.add_parser("brief", help="SessionStart 用要約"); x.set_defaults(fn=cmd_brief)
    x.add_argument("--json", action="store_true")
    return p


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    safe = bool(argv) and argv[0] in ("context", "brief")
    try:
        args = build_parser().parse_args(argv)
        return args.fn(args) or 0
    except SystemExit as e:
        if safe:
            return 0
        raise
    except BrokenPipeError:
        return 0
    except BaseException as e:  # noqa: BLE001
        if safe:
            return 0
        if isinstance(e, KeyboardInterrupt):
            return 130
        print(f"herdr-orch: {type(e).__name__}: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
